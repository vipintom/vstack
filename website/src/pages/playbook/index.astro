---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import Card from '@components/Card.astro';
import CodeBlock from '@components/CodeBlock.astro';
import Badge from '@components/Badge.astro';
import Button from '@components/Button.astro';
import { playbookProduct } from '@data/products';
import { capabilityCategories } from '@data/capabilities';
import { productIntros } from '@data/editorial';
import { withBase } from '../../utils/urls';
---

<Doc title={playbookProduct.identity.name} description={playbookProduct.identity.shortDescription}>
  <Section id="playbook" gap="l" aria-labelledby="playbook-title">
    <Container>
      <h1 id="playbook-title">{playbookProduct.identity.name}</h1>
      <p class="lead">{playbookProduct.identity.description}</p>

      <div class="pillar-grid">
        <Card 
          title="Skills (55)" 
          description="Reusable playbooks for AI-assisted development. Categories: Foundation, Discovery, Architecture, Planning, Verification, Debug/Recovery, Collaboration, Review, Continuity, Delivery, Extended, Implementation, Utils." 
          actionLabel="View Skills" 
          actionHref={withBase('/playbook/skills/')} 
          badgeLabels={["Core"]} 
          badgeVariants={["info"]} 
        />
        <Card 
          title="Workflows (18)" 
          description="Composable workflows for common scenarios: feature delivery, bug fixing, refactoring, infrastructure changes, investigations, and more." 
          actionLabel="View Workflows" 
          actionHref={withBase('/playbook/workflows/')} 
          badgeLabels={["Process"]} 
          badgeVariants={["pass"]} 
        />
        <Card 
          title="Principles (17)" 
          description="Engineering principles that guide design decisions: evidence before completion, smallest complete change, model domain explicitly, and more." 
          actionLabel="View Principles" 
          actionHref={withBase('/playbook/principles/')} 
          badgeLabels={["Guidance"]} 
          badgeVariants={["warn"]} 
        />
        <Card 
          title="Resources" 
          description="Reference materials, templates, and review rubrics: quick reference cards, delivery plan templates, handoff templates, review finding templates." 
          actionLabel="View Resources" 
          actionHref={withBase('/playbook/resources/')} 
          badgeLabels={["Reference"]} 
          badgeVariants={["info"]} 
        />
      </div>

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <h2>Installation</h2>
      {playbookProduct.installation.map(inst => (
        <>
          <h3>{inst.name}</h3>
          <CodeBlock code={inst.command} language="bash" showCopy={true} copyLabel="Copy" copySuccess="Copied!" />
          <p style="font-size: var(--text-sm); color: var(--color-ink-muted); margin-top: var(--space-sm);">{inst.description}</p>
          {inst.prerequisites.length > 0 && (
            <p style="font-size: var(--text-sm); color: var(--color-ink-muted); margin-top: var(--space-xs);"><strong>Prerequisites:</strong> {inst.prerequisites.join(', ')}</p>
          )}
        </>
      ))}

      <h2 style="margin-top: var(--space-2xl);">Capability Matrix</h2>
      <p>Single source of truth: 55 skills × 3 harnesses (OpenCode, Codex, Claude Code)</p>
      <CodeBlock code="cat docs/capability-matrix.md" language="bash" />
      
      <h2 style="margin-top: var(--space-2xl);">Harness Support</h2>
      <ul style="list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-lg);">
        {playbookProduct.capabilities.byStatus && Object.entries(playbookProduct.capabilities.byStatus).map(([status, count]) => (
          <li style="background: var(--color-paper-2); border: 1px solid var(--color-rule); border-radius: var(--radius-md); padding: var(--space-md); min-width: 150px;">
            <strong>{status.charAt(0).toUpperCase() + status.slice(1)}:</strong> {count} skills
          </li>
        ))}
      </ul>
    </Container>
  </Section>
</Doc>

<style>
  .pillar-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--gap-columns); }
  @media (max-width: 768px) { .pillar-grid { grid-template-columns: 1fr; } }
</style>