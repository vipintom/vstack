---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import Card from '@components/Card.astro';
import CodeBlock from '@components/CodeBlock.astro';
---

<Doc title="vstack Playbook" description="Portable playbook: 55 skills, 18 workflows, 17 principles. Works with OpenCode, Codex, and Claude Code.">
  <Section id="playbook" gap="l" aria-labelledby="playbook-title">
    <Container>
      <h1 id="playbook-title">vstack Playbook</h1>
      <p class="lead">Portable engineering playbook: 55 skills, 18 workflows, 17 principles. Zero runtime code — pure Markdown/YAML content.</p>

      <div class="pillar-grid">
        <Card title="Skills (55)" description="Reusable playbooks for AI-assisted development. Categories: Foundation, Discovery, Architecture, Planning, Verification, Debug/Recovery, Collaboration, Review, Continuity, Delivery, Extended, Implementation, Utils." actionLabel="View Skills" actionHref="/playbook/skills/" badgeLabels={["Core"]} badgeVariants={["info"]} />
        <Card title="Workflows (18)" description="Composable workflows for common scenarios: feature delivery, bug fixing, refactoring, infrastructure changes, investigations, and more." actionLabel="View Workflows" actionHref="/playbook/workflows/" badgeLabels={["Process"]} badgeVariants={["pass"]} />
        <Card title="Principles (17)" description="Engineering principles that guide design decisions: evidence before completion, smallest complete change, model domain explicitly, and more." actionLabel="View Principles" actionHref="/playbook/principles/" badgeLabels={["Guidance"]} badgeVariants={["warn"]} />
        <Card title="Resources (12)" description="Reference materials, templates, and review rubrics: quick reference cards, delivery plan templates, handoff templates, review finding templates." actionLabel="View Resources" actionHref="/playbook/resources/" badgeLabels={["Reference"]} badgeVariants={["info"]} />
      </div>

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <h2>Installation</h2>
      <CodeBlock code="opencode skill install vstack" language="bash" />

      <h2 style="margin-top: var(--space-2xl);">Capability Matrix</h2>
      <p>Single source of truth: 55 skills × 3 harnesses (OpenCode, Codex, Claude Code)</p>
      <CodeBlock code="cat docs/capability-matrix.md" language="bash" />
    </Container>
  </Section>
</Doc>

<style>
  .pillar-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--gap-columns); }
  @media (max-width: 768px) { .pillar-grid { grid-template-columns: 1fr; } }
</style>