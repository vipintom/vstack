---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import Card from '@components/Card.astro';
import Badge from '@components/Badge.astro';
import { getCollection } from 'astro:content';
import { playbookSidebar } from '@data/playbook-sidebar';

const principles = await getCollection('principles');
const principleCardProps = principles.map(principle => ({
  title: principle.data.name,
  description: principle.data.statement,
  actionLabel: 'View',
  actionHref: '/playbook/principles/' + principle.slug + '/',
  badgeLabels: ['Principle'],
  badgeVariants: ['pass'],
}));
const emptyState = principles.length === 0;

const docTitle = "Principles - vstack Playbook";
const docDescription = "17 engineering principles that guide vstack";
const docSidebarTitle = "Playbook";
---

<Doc title={docTitle} description={docDescription} sidebarTitle={docSidebarTitle} sidebarItems={playbookSidebar.principles}>
  <Section id="principles-index" gap="l" aria-labelledby="principles-title">
    <Container>
      <div class="page-header">
        <h1 id="principles-title">Principles</h1>
        <p class="lead">17 engineering principles that guide vstack design and decisions.</p>
      </div>

      <div class="principles-grid">
        {principleCardProps.map(props => <Card {...props} />)}
      </div>

      {emptyState && <p class="empty-state">No principles found.</p>}
    </Container>
  </Section>
</Doc>

<style>
  .page-header { margin-bottom: var(--space-xl); }
  .page-header h1 { margin-bottom: var(--space-xs); }
  .page-header .lead { margin: 0; }

  .principles-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--gap-columns); }
  @media (max-width: 768px) { .principles-grid { grid-template-columns: 1fr; } }

  .empty-state { text-align: center; color: var(--color-ink-muted); padding: var(--space-3xl); }
</style>