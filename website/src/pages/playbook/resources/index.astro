---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import Card from '@components/Card.astro';
import Badge from '@components/Badge.astro';
import { getCollection } from 'astro:content';
import { playbookSidebar } from '@data/playbook-sidebar';

const resources = await getCollection('resources');
const resourceCardProps = resources.map(resource => ({
  title: resource.data.name,
  description: resource.data.description || 'Resource documentation',
  actionLabel: 'View',
  actionHref: '/playbook/resources/' + resource.slug + '/',
  badgeLabels: [resource.data.category || 'reference'],
  badgeVariants: ['info'],
}));
const emptyState = resources.length === 0;

const docTitle = "Resources - vstack Playbook";
const docDescription = "Reference materials, templates, and review rubrics";
const docSidebarTitle = "Playbook";
---

<Doc title={docTitle} description={docDescription} sidebarTitle={docSidebarTitle} sidebarItems={playbookSidebar.resources}>
  <Section id="resources-index" gap="l" aria-labelledby="resources-title">
    <Container>
      <div class="page-header">
        <h1 id="resources-title">Resources</h1>
        <p class="lead">Reference materials, templates, and review rubrics.</p>
      </div>

      <div class="resources-grid">
        {resourceCardProps.map(props => <Card {...props} />)}
      </div>

      {emptyState && <p class="empty-state">No resources found.</p>}
    </Container>
  </Section>
</Doc>

<style>
  .page-header { margin-bottom: var(--space-xl); }
  .page-header h1 { margin-bottom: var(--space-xs); }
  .page-header .lead { margin: 0; }

  .resources-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--gap-columns); }
  @media (max-width: 768px) { .resources-grid { grid-template-columns: 1fr; } }

  .empty-state { text-align: center; color: var(--color-ink-muted); padding: var(--space-3xl); }
</style>