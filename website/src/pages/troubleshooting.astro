---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import CodeBlock from '@components/CodeBlock.astro';
import DataTable from '@components/DataTable.astro';
import Card from '@components/Card.astro';
---

<Doc title="Troubleshooting" description="Troubleshooting guide for vstack components: Playbook, OpenCode Plugin, OpenChamber Extension">
  <Section id="troubleshooting" gap="l" aria-labelledby="ts-title">
    <Container>
      <h1 id="ts-title">Troubleshooting</h1>
      <p class="lead">Diagnose and resolve issues across the vstack ecosystem.</p>

      <div class="pillar-grid" style="margin-bottom: var(--space-2xl);">
        <Card title="Playbook Issues" description="Skill validation, installation, workflow execution" actionLabel="View" actionHref="#playbook" badgeLabels={["Skills", "Workflows"]} badgeVariants={["info"]} />
        <Card title="OpenCode Plugin" description="Tools, stores, agents, projections, permissions" actionLabel="View" actionHref="#opencode" badgeLabels={["Runtime", "23 Tools"]} badgeVariants={["pass"]} />
        <Card title="OpenChamber" description="Panel, dashboard, projections, permissions" actionLabel="View" actionHref="#openchamber" badgeLabels={["Visualization", "Read-only"]} badgeVariants={["warn"]} />
      </div>

      <h2 id="playbook" style="margin-top: var(--space-2xl);">Playbook Troubleshooting</h2>

      <h3>Skill Installation Issues</h3>
      <DataTable
        columns={[
          { key: 'issue', header: 'Issue', sortable: true },
          { key: 'cause', header: 'Cause', sortable: false },
          { key: 'fix', header: 'Fix', sortable: false },
        ]}
        data={[
          ['Skill not found', 'Not in manifest or wrong name', 'Check skill name: opencode skill list | grep vstack'],
          ['Validation errors', 'Schema/content mismatch', 'Run: node scripts/validate-content.js in playbook repo'],
          ['Adapter missing', 'Harness adapter not generated', 'Run install script for your harness'],
          ['Workflow not loading', 'Playbook path incorrect', 'Verify ~/.config/opencode/skills/vstack/playbook/ exists'],
        ]}
        emptyState={false}
      />

      <h3>Content Validation</h3>
      <CodeBlock code={`# Validate playbook content
cd vstack-playbook
node scripts/validate-content.js

# Expected: 0 errors, 0 warnings`} language="bash" showCopy={true} copyLabel="Copy" />

      <h2 id="opencode" style="margin-top: var(--space-2xl);">OpenCode Plugin Troubleshooting</h2>

      <h3>Quick Diagnostics</h3>
      <CodeBlock code={`# System health
vstack_status

# Tool registry
vstack_status --tools

# Projection status
vstack_status --projections

# Storage backend
vstack_status --storage`} language="bash" showCopy={true} copyLabel="Copy" />

      <h3>Common Issues</h3>
      <DataTable
        columns={[
          { key: 'issue', header: 'Issue', sortable: true },
          { key: 'diagnosis', header: 'Diagnosis', sortable: false },
          { key: 'resolution', header: 'Resolution', sortable: false },
        ]}
        data={[
          ['Tools not appearing', 'Plugin not loaded', 'Restart OpenCode; check ~/.config/opencode/plugins/'],
          ['Permission denied on .vstack/', 'Files capability not granted', 'OpenChamber: Settings → Capabilities → Files → Grant'],
          ['Projections not updating', 'Publisher not running', 'Check vstack_status --projections; restart plugin'],
          ['Schema validation errors', 'Version mismatch', 'Check contracts/projections/v1/ matches plugin version'],
          ['Agent dispatch fails', 'Adapters not installed', 'Run: opencode skill install vstack'],
          ['Delivery create fails', 'Invalid profile/type', 'Use valid profile: feature, bugfix, refactor, migration, etc.'],
          ['Completion blocked', 'Required checks failing', 'Run vstack_check verify; fix failing checks'],
          ['Memory not persisting', 'Storage path issue', 'Check VSTACK_ROOT or repo root detection'],
          ['TypeScript errors', 'Version mismatch', 'Ensure @opencode/plugin@2.2.0 peer dependency'],
        ]}
        emptyState={false}
      />

      <h3>Debug Commands</h3>
      <CodeBlock code={`# Inspect delivery state
vstack_delivery get --id dlv_abc123

# List tasks for delivery
vstack_task list --delivery dlv_abc123

# View memory entries
vstack_memory list

# Check evidence for task
vstack_evidence list --task tsk_xyz

# View review sessions
vstack_review list --delivery dlv_abc123

# Projection debugging
cat .vstack/state/index.json | jq .
cat .vstack/reports/deliveries/dlv_abc123.json | jq .
vstack_projection validate --all
vstack_projection publish --all --force`} language="bash" showCopy={true} copyLabel="Copy" />

      <h3>Log Analysis</h3>
      <CodeBlock code={`# Plugin logs (OpenCode)
opencode logs --plugin vstack

# Event log (audit trail)
cat .vstack/events.jsonl | tail -50

# Filter by event type
cat .vstack/events.jsonl | jq 'select(.type == "delivery.completed")'

# Check for errors
cat .vstack/events.jsonl | jq 'select(.level == "error")'`} language="bash" showCopy={true} copyLabel="Copy" />

      <h3>Recovery Procedures</h3>
      <CodeBlock code={`# Corrupted projection
rm .vstack/reports/deliveries/dlv_xxx.json
vstack_projection publish --delivery dlv_xxx --force
vstack_projection validate --delivery dlv_xxx

# Stuck delivery
vstack_delivery can-complete --id dlv_xxx
vstack_review list --delivery dlv_xxx
vstack_evidence list --delivery dlv_xxx

# Full state recovery
vstack_recovery restore --checkpoint latest
vstack_recovery reconcile --full`} language="bash" showCopy={true} copyLabel="Copy" />

      <h2 id="openchamber" style="margin-top: var(--space-2xl);">OpenChamber Extension Troubleshooting</h2>

      <h3>Quick Diagnostic</h3>
      <CodeBlock code={`# Check OpenChamber version
openchamber --version

# Check extension loaded
# Settings → Extensions → vstack Workflow

# Check files permission
# Settings → Capabilities → Files → Should show 'Granted'

# Check projections exist
ls -la .vstack/reports/
ls -la .vstack/state/`} language="bash" showCopy={true} copyLabel="Copy" />

      <h3>Common Issues</h3>
      <DataTable
        columns={[
          { key: 'issue', header: 'Issue', sortable: true },
          { key: 'cause', header: 'Root Cause', sortable: false },
          { key: 'solution', header: 'Solution', sortable: false },
        ]}
        data={[
          ['Panel shows "No project open"', 'No .vstack/ in current project', 'Run vstack workflow in this project first'],
          ['Panel shows "Files permission denied"', 'Files capability not granted', 'Settings → Capabilities → Files → Grant'],
          ['Panel shows "Unsupported schema version"', 'Manifest schemaVersion !== 1', 'Check .vstack/manifest.json; ensure OpenCode plugin v0.1.0+'],
          ['Panel shows "No vstack workflow found"', 'Manifest missing or invalid', 'Verify .vstack/manifest.json exists and has schemaVersion: 1'],
          ['Panel shows "No active workflow state"', 'Dashboard index missing', 'Run vstack_projection publish --all from OpenCode'],
          ['Dashboard empty / no deliveries', 'No deliveries created', 'Create delivery: vstack_delivery create --title "My Work" --objective "..." --createdBy "user"'],
          ['Data not updating', 'Polling not working', 'Click Refresh button; check browser console for errors'],
          ['Extension not in Panels', 'Extension not enabled', 'Settings → Extensions → vstack Workflow → Enable'],
          ['Page not appearing', 'Extension page not registered', 'Restart OpenChamber after enabling extension'],
          ['Theme not applying', 'Theme sync issue', 'Refresh OpenChamber; check body[data-theme] in DevTools'],
        ]}
        emptyState={false}
      />

      <h3>Error Reference</h3>
      <DataTable
        columns={[
          { key: 'error', header: 'Error Message', sortable: true },
          { key: 'location', header: 'Where', sortable: false },
          { key: 'fix', header: 'Fix', sortable: false },
        ]}
        data={[
          ['NOT_GRANTED: files', 'Browser console / panel UI', 'Grant Files capability in OpenChamber Settings'],
          ['Unsupported schema version: 2', 'Panel UI', 'Update OpenChamber extension to support v2'],
          ['Failed to load dashboard', 'Browser console', 'Check projections exist; verify file permissions'],
          ['Delivery report not found', 'Delivery Detail tab', 'Run vstack_projection publish --delivery <id>'],
          ['No active deliveries', 'Overview tab', 'Create a delivery in OpenCode'],
          ['Permission denied reading .vstack/', 'Browser console', 'Fix file permissions; ensure OpenChamber has read access'],
        ]}
        emptyState={false}
      />

      <h3>Reset Procedures</h3>
      <CodeBlock code={`# Soft reset (clear cache)
# Close OpenChamber, delete browser cache, reopen

# Hard reset (reinstall extension)
# Disable → Remove → Reinstall via Extension Manager
# Grant Files capability again

# Projection reset
vstack_projection publish --all --force
# Or delete and regenerate
rm -rf .vstack/reports .vstack/state
vstack_projection publish --all`} language="bash" showCopy={true} copyLabel="Copy" />

      <h2 style="margin-top: var(--space-2xl);">Getting Help</h2>
      <div class="pillar-grid">
        <Card title="GitHub Issues" description="Report bugs and request features" actionLabel="Playbook Issues" actionHref="https://github.com/vipintom/vstack-playbook/issues" badgeLabels={["Skills", "Workflows"]} badgeVariants={["info"]} />
        <Card title="OpenCode Plugin" description="Plugin-specific issues" actionLabel="OpenCode Issues" actionHref="https://github.com/vipintom/vstack-opencode/issues" badgeLabels={["Runtime", "Tools"]} badgeVariants={["pass"]} />
        <Card title="OpenChamber" description="Extension-specific issues" actionLabel="OpenChamber Issues" actionHref="https://github.com/vipintom/vstack-openchamber/issues" badgeLabels={["Visualization"]} badgeVariants={["warn"]} />
        <Card title="Discussions" description="Ask questions, share patterns" actionLabel="GitHub Discussions" actionHref="https://github.com/vipintom/vstack/discussions" badgeLabels={["Community"]} badgeVariants={["info"]} />
      </div>

      <h2 style="margin-top: var(--space-2xl);">Reporting Bugs</h2>
      <p>When filing an issue, include:</p>
      <ol>
        <li>Component: Playbook / OpenCode Plugin / OpenChamber</li>
        <li>Version (from <code>vstack_status</code> or package.json)</li>
        <li>Harness: OpenCode / Codex / Claude Code</li>
        <li>OS and Node.js version</li>
        <li>Error messages (full text, not screenshots)</li>
        <li>Reproduction steps (minimal)</li>
        <li>Relevant logs/projection files (sanitized)</li>
      </ol>
    </Container>
  </Section>
</Doc>