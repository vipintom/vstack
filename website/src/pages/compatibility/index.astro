---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import DataTable from '@components/DataTable.astro';
import CodeBlock from '@components/CodeBlock.astro';
import { capabilityMatrix, categorySummary, harnessSummary } from '@data/capability-matrix';
---

<Doc title="Compatibility Matrix" description="vstack ecosystem compatibility across harnesses and versions">
  <Section id="compatibility" gap="l" aria-labelledby="compat-title">
    <Container>
      <h1 id="compat-title">Compatibility Matrix</h1>
      <p class="lead">Cross-repository compatibility for vstack ecosystem v0.1.0 / Playbook 2.0</p>

      <h2>Repository Versions</h2>
      <DataTable
        columns={[
          { key: 'repo', header: 'Repository', sortable: true },
          { key: 'version', header: 'Version', sortable: true },
          { key: 'description', header: 'Description', sortable: false },
        ]}
        data={[
          ['vstack-playbook', '0.1.0', 'Portable playbook: 55 skills, 18 workflows, 17 principles'],
          ['vstack-opencode', '0.1.0', 'OpenCode plugin: 23 tools, 3 agents, 6 stores, 7 gates'],
          ['vstack-openchamber', '0.1.0', 'OpenChamber panel: Notes, Todos, Plans visualization'],
          ['vstack (umbrella)', '0.1.0', 'Contracts, matrix, wiki, knowledge base'],
        ]}
        emptyState={false}
      />

      <h2 style="margin-top: var(--space-2xl);">Harness Support</h2>
      <p>Skill support across AI harnesses (from capability matrix)</p>
      <DataTable
        columns={[
          { key: 'harness', header: 'Harness', sortable: true },
          { key: 'full', header: 'Full Support', sortable: true },
          { key: 'partial', header: 'Partial Support', sortable: true },
          { key: 'planned', header: 'Planned', sortable: true },
          { key: 'none', header: 'Not Supported', sortable: true },
        ]}
        data={harnessSummary.map(h => [
          h.harness,
          String(h.full),
          String(h.partial),
          String(h.planned),
          String(h.none),
        ])}
        emptyState={false}
      />

      <h2 style="margin-top: var(--space-2xl);">Category Distribution</h2>
      <DataTable
        columns={[
          { key: 'category', header: 'Category', sortable: true },
          { key: 'count', header: 'Skills', sortable: true },
        ]}
        data={categorySummary.map(c => [c.category, String(c.count)])}
        emptyState={false}
      />

      <h2 style="margin-top: var(--space-2xl);">Release Artifacts</h2>
      <CodeBlock code="# Playbook distribution package\nvstack-playbook-0.1.0.tgz\n\n# OpenCode plugin (npm)\nnpm install @vipintom/vstack-opencode@0.1.0\n\n# OpenChamber panel (npm)\nnpm install @vipintom/vstack-openchamber@0.1.0" language="bash" />

      <h2 style="margin-top: var(--space-2xl);">Links</h2>
      <ul>
        <li><a href="https://github.com/vipintom/vstack-playbook">vstack-playbook repository</a></li>
        <li><a href="https://github.com/vipintom/vstack-opencode">vstack-opencode repository</a></li>
        <li><a href="https://github.com/vipintom/vstack-openchamber">vstack-openchamber repository</a></li>
        <li><a href="https://github.com/vipintom/vstack-workflow">vstack-workflow (this repo)</a></li>
        <li><a href="/playbook/docs/capability-matrix.md">Capability Matrix (Markdown)</a></li>
      </ul>
    </Container>
  </Section>
</Doc>