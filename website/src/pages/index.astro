---
import Landing from '@layouts/Landing.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import Button from '@components/Button.astro';
import CodeBlock from '@components/CodeBlock.astro';
import Badge from '@components/Badge.astro';
import DataTable from '@components/DataTable.astro';
import SearchInput from '@components/SearchInput.astro';
import Card from '@components/Card.astro';
import Search from '@components/Search.astro';
import { capabilityData, harnessSummary, capabilityCategories } from '@data/capabilities';
import { playbookProduct, opencodePluginProduct, openchamberProduct } from '@data/products';
import { heroContent, architectureSummary, productComparison, gettingStarted, releaseInfo, productIntros } from '@data/editorial';
import { withBase } from '../utils/urls';

// Pillar card props from canonical data
const pillarCardProps = [
  {
    title: playbookProduct.identity.name,
    description: playbookProduct.identity.shortDescription,
    actionLabel: 'Explore Playbook',
    actionHref: withBase('/playbook/'),
    badgeLabels: ['55 Skills', '18 Workflows', '17 Principles'],
    badgeVariants: ['info', 'pass', 'warn'],
  },
  {
    title: opencodePluginProduct.identity.name,
    description: opencodePluginProduct.identity.shortDescription,
    actionLabel: 'View Plugin',
    actionHref: withBase('/opencode-plugin/'),
    badgeLabels: ['23 Tools', '3 Agents', '7 Gates'],
    badgeVariants: ['info', 'pass', 'warn'],
  },
  {
    title: openchamberProduct.identity.name,
    description: openchamberProduct.identity.shortDescription,
    actionLabel: 'Open Panel',
    actionHref: withBase('/openchamber/'),
    badgeLabels: ['Notes', 'Todos', 'Plans'],
    badgeVariants: ['info', 'pass', 'warn'],
  },
];

// Architecture layer data from capability categories
const archLayers = capabilityCategories.map(cat => ({
  name: cat.name,
  skills: cat.capabilities.map(c => c.id),
}));

// Install commands from canonical data
const installCommands = playbookProduct.installation.map(inst => ({
  platform: inst.name.replace('Playbook ', '').replace('OpenCode ', '').replace('Claude Code', 'Claude Code'),
  command: inst.command,
  description: inst.description,
}));

const capabilityRows = capabilityData.capabilities
  .filter(c => c.component === 'playbook')
  .map(row => [
    row.name,
    row.category,
    row.status.opencode,
    row.status.codex,
    row.status.claudeCode,
  ]);

const emptyState = capabilityData.capabilities.length === 0;
const matrixSearchId = "matrix-search";
const matrixCategoryFilterId = "matrix-category-filter";

---

<Landing title={heroContent.title} description="Portable engineering playbook for AI-assisted development">
  <Section id="hero" class="hero-section">
    <Container>
      <div class="hero-grid">
        <div class="hero-text">
          <h1>vstack</h1>
          <p class="hero-sentence">Portable engineering playbook for AI-assisted development.</p>
          <div class="hero-actions">
            <Button href={withBase('/playbook/')} variant="primary" size="lg">Explore Playbook</Button>
            <Button href={withBase('/opencode-plugin/')} variant="secondary" size="lg">OpenCode Plugin</Button>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <svg viewBox="0 0 800 400" preserveAspectRatio="xMidYMid meet" class="arch-svg" role="img" aria-labelledby="arch-title">
            <title id="arch-title">vstack system architecture</title>
            <defs>
              <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
                <polygon points="0 0, 10 3.5, 0 7" fill="var(--color-border)" />
              </marker>
              <linearGradient id="grad-playbook" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="var(--chart-1)" stop-opacity="0.2" />
                <stop offset="100%" stop-color="var(--chart-1)" stop-opacity="0.05" />
              </linearGradient>
              <linearGradient id="grad-opencode" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="var(--chart-2)" stop-opacity="0.2" />
                <stop offset="100%" stop-color="var(--chart-2)" stop-opacity="0.05" />
              </linearGradient>
              <linearGradient id="grad-openchamber" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="var(--chart-3)" stop-opacity="0.2" />
                <stop offset="100%" stop-color="var(--chart-3)" stop-opacity="0.05" />
              </linearGradient>
              <linearGradient id="grad-umbrella" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="var(--chart-4)" stop-opacity="0.2" />
                <stop offset="100%" stop-color="var(--chart-4)" stop-opacity="0.05" />
              </linearGradient>
            </defs>

            <!-- Umbrella Repository (center top) -->
            <rect x="275" y="20" width="250" height="100" rx="12" fill="url(#grad-umbrella)" stroke="var(--chart-4)" stroke-width="2" />
            <text x="400" y="55" text-anchor="middle" font-size="16" font-weight="600" fill="var(--color-ink)">vstack (umbrella)</text>
            <text x="400" y="78" text-anchor="middle" font-size="12" fill="var(--color-ink-muted)">Contracts, Matrix, Release</text>
            <text x="400" y="96" text-anchor="middle" font-size="11" fill="var(--color-ink-muted)">github.com/vipintom/vstack</text>

            <!-- Playbook (left) -->
            <rect x="30" y="160" width="220" height="180" rx="12" fill="url(#grad-playbook)" stroke="var(--chart-1)" stroke-width="2" />
            <text x="140" y="195" text-anchor="middle" font-size="16" font-weight="600" fill="var(--color-ink)">vstack-playbook</text>
            <text x="140" y="218" text-anchor="middle" font-size="12" fill="var(--color-ink-muted)">55 Skills, 18 Workflows</text>
            <text x="140" y="236" text-anchor="middle" font-size="12" fill="var(--color-ink-muted)">17 Principles, 3 Roles</text>
            <text x="140" y="254" text-anchor="middle" font-size="11" fill="var(--color-ink-muted)">npm @vipintom/vstack</text>
            <text x="140" y="272" text-anchor="middle" font-size="11" fill="var(--color-ink-muted)">github.com/vipintom/vstack-playbook</text>
            <text x="140" y="300" text-anchor="middle" font-size="11" font-weight="500" fill="var(--chart-1)">Defines methodology</text>

            <!-- OpenCode Plugin (center) -->
            <rect x="290" y="160" width="220" height="180" rx="12" fill="url(#grad-opencode)" stroke="var(--chart-2)" stroke-width="2" />
            <text x="400" y="195" text-anchor="middle" font-size="16" font-weight="600" fill="var(--color-ink)">vstack-opencode</text>
            <text x="400" y="218" text-anchor="middle" font-size="12" fill="var(--color-ink-muted)">23 Tools, 3 Agents</text>
            <text x="400" y="236" text-anchor="middle" font-size="12" fill="var(--color-ink-muted)">6 Stores, 7 Gates</text>
            <text x="400" y="254" text-anchor="middle" font-size="11" fill="var(--color-ink-muted)">npm @vipintom/vstack-opencode</text>
            <text x="400" y="272" text-anchor="middle" font-size="11" fill="var(--color-ink-muted)">github.com/vipintom/vstack-opencode</text>
            <text x="400" y="300" text-anchor="middle" font-size="11" font-weight="500" fill="var(--chart-2)">Owns runtime state</text>

            <!-- OpenChamber (right) -->
            <rect x="550" y="160" width="220" height="180" rx="12" fill="url(#grad-openchamber)" stroke="var(--chart-3)" stroke-width="2" />
            <text x="660" y="195" text-anchor="middle" font-size="16" font-weight="600" fill="var(--color-ink)">vstack-openchamber</text>
            <text x="660" y="218" text-anchor="middle" font-size="12" fill="var(--color-ink-muted)">Panel + Dashboard</text>
            <text x="660" y="236" text-anchor="middle" font-size="12" fill="var(--color-ink-muted)">Read-only projections</text>
            <text x="660" y="254" text-anchor="middle" font-size="11" fill="var(--color-ink-muted)">Git URL / Built ZIP</text>
            <text x="660" y="272" text-anchor="middle" font-size="11" fill="var(--color-ink-muted)">github.com/vipintom/vstack-openchamber</text>
            <text x="660" y="300" text-anchor="middle" font-size="11" font-weight="500" fill="var(--chart-3)">Visualizes state</text>

            <!-- Projection flow arrows -->
            <path d="M 400 120 Q 350 140 300 160" stroke="var(--color-border)" stroke-width="2" fill="none" marker-end="url(#arrowhead)" stroke-dasharray="5,5" />
            <path d="M 400 120 Q 400 140 400 160" stroke="var(--color-border)" stroke-width="2" fill="none" marker-end="url(#arrowhead)" stroke-dasharray="5,5" />
            <path d="M 400 120 Q 450 140 550 160" stroke="var(--color-border)" stroke-width="2" fill="none" marker-end="url(#arrowhead)" stroke-dasharray="5,5" />

            <!-- Projection labels -->
            <text x="350" y="130" text-anchor="middle" font-size="10" fill="var(--color-ink-muted)">projections v1</text>
            <text x="400" y="135" text-anchor="middle" font-size="10" fill="var(--color-ink-muted)">manifest.json</text>
            <text x="450" y="130" text-anchor="middle" font-size="10" fill="var(--color-ink-muted)">projections v1</text>

            <!-- Data flow arrows -->
            <path d="M 250 250 L 290 250" stroke="var(--chart-2)" stroke-width="2" fill="none" marker-end="url(#arrowhead)" />
            <text x="270" y="240" text-anchor="middle" font-size="10" fill="var(--chart-2)">Skills CLI</text>

            <path d="M 510 250 L 550 250" stroke="var(--chart-3)" stroke-width="2" fill="none" marker-end="url(#arrowhead)" />
            <text x="530" y="240" text-anchor="middle" font-size="10" fill="var(--chart-3)">Projections</text>

            <!-- .vstack directory -->
            <rect x="290" y="360" width="220" height="35" rx="8" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1.5" stroke-dasharray="4,4" />
            <text x="400" y="385" text-anchor="middle" font-size="12" fill="var(--color-ink-muted)">.vstack/ (shared project root)</text>
            <text x="400" y="397" text-anchor="middle" font-size="10" fill="var(--color-ink-muted)">manifest.json, state/, reports/, deliveries/, events.jsonl</text>
          </svg>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="capability-matrix" gap="l" aria-labelledby="matrix-title">
    <Container>
      <header class="section-header">
        <h2 id="matrix-title">Capability Matrix</h2>
        <p class="section-lead">55 skills × 3 harnesses</p>
      </header>

      <div class="matrix-controls">
        <SearchInput id={matrixSearchId} placeholder="Filter skills by name..." aria-label="Search skills" />
        <select id={matrixCategoryFilterId} aria-label="Filter by category">
          <option value="">All Categories</option>
          <option value="Foundation">Foundation</option>
          <option value="Discovery">Discovery</option>
          <option value="Architecture">Architecture</option>
          <option value="Planning">Planning</option>
          <option value="Verification">Verification</option>
          <option value="Debug/Recovery">Debug/Recovery</option>
          <option value="Collaboration">Collaboration</option>
          <option value="Review">Review</option>
          <option value="Continuity">Continuity</option>
          <option value="Delivery">Delivery</option>
          <option value="Extended">Extended</option>
          <option value="Implementation">Implementation</option>
          <option value="Utils">Utils</option>
        </select>
      </div>

      <div class="matrix-table-wrap">
        <DataTable
          columns={[
            { key: 'name', header: 'Skill', sortable: true },
            { key: 'category', header: 'Category', sortable: true },
            { key: 'opencode', header: 'OpenCode', sortable: true },
            { key: 'codex', header: 'Codex', sortable: true },
            { key: 'claude', header: 'Claude Code', sortable: true },
          ]}
          data={capabilityRows}
          searchId={matrixSearchId}
          categoryFilterId={matrixCategoryFilterId}
          categoryColumnIndex={1}
          emptyState={emptyState}
          emptyMessage="No skills match the current filter."
        />
      </div>
    </Container>
  </Section>

  <Section id="three-pillars" gap="l" aria-labelledby="pillars-title">
    <Container>
      <header class="section-header">
        <h2 id="pillars-title">Three Pillars</h2>
        <p class="section-lead">Playbook, OpenCode Plugin, OpenChamber</p>
      </header>

      <div class="pillars-grid">
        {pillarCardProps.map(props => <Card {...props} />)}
      </div>
    </Container>
  </Section>

  <Section id="architecture" gap="l" aria-labelledby="arch-title">
    <Container>
      <header class="section-header">
        <h2 id="arch-title">Architecture</h2>
        <p class="section-lead">14 layers, 55 skills</p>
      </header>

      <div class="arch-layers-wrap">
        <div class="arch-layers">
          {archLayers.map(layer => (
            <details class="arch-layer" open={layer.name === 'Foundation' || layer.name === 'Discovery'}>
              <summary>{layer.name} <span class="layer-count">{layer.skills.length} skills</span></summary>
              <ul class="layer-skills">
                {layer.skills.map(skill => <li><a href={withBase(`/playbook/skills/${skill.toLowerCase()}/`)}>{skill}</a></li>)}
              </ul>
            </details>
          ))}
        </div>
      </div>
    </Container>
  </Section>

  <Section id="installation" gap="l" aria-labelledby="install-title">
    <Container>
      <header class="section-header">
        <h2 id="install-title">Installation</h2>
        <p class="section-lead">One command</p>
      </header>

      <div class="install-wrap">
        <div class="install-grid">
          {installCommands.map(cmd => (
            <article class="install-card">
              <h3>{cmd.platform}</h3>
              <CodeBlock code={cmd.command} language="bash" showCopy={true} copyLabel="Copy" copySuccess="Copied!" />
            </article>
          ))}
        </div>
      </div>
    </Container>
  </Section>

  <Section id="reference-index" gap="l" aria-labelledby="ref-title">
    <Container>
      <header class="section-header">
        <h2 id="ref-title">Reference Index</h2>
        <p class="section-lead">Docs</p>
      </header>

      <div class="ref-grid">
        <article class="ref-card">
          <h3>Playbook</h3>
          <ul>
            <li><a href={withBase('/playbook/skills/')}>55 Skills</a></li>
            <li><a href={withBase('/playbook/workflows/')}>18 Workflows</a></li>
            <li><a href={withBase('/playbook/principles/')}>17 Principles</a></li>
            <li><a href={withBase('/compatibility/')}>Matrix</a></li>
          </ul>
        </article>
        <article class="ref-card">
          <h3>OpenCode Plugin</h3>
          <ul>
            <li><a href={withBase('/opencode-plugin/tools/')}>23 Tools</a></li>
            <li><a href={withBase('/opencode-plugin/agents/')}>3 Agents</a></li>
            <li><a href={withBase('/opencode-plugin/stores/')}>6 Stores</a></li>
            <li><a href={withBase('/opencode-plugin/gates/')}>7 Gates</a></li>
          </ul>
        </article>
        <article class="ref-card">
          <h3>OpenChamber</h3>
          <ul>
            <li><a href={withBase('/openchamber/')}>Panel</a></li>
            <li><a href={withBase('/openchamber/notes/')}>Notes</a></li>
            <li><a href={withBase('/openchamber/todos/')}>Todos</a></li>
            <li><a href={withBase('/openchamber/plans/')}>Plans</a></li>
          </ul>
        </article>
        <article class="ref-card">
          <h3>Meta</h3>
          <ul>
            <li><a href="https://github.com/vipintom/vstack-playbook" target="_blank" rel="noopener">Playbook Repo</a></li>
            <li><a href="https://github.com/vipintom/vstack-opencode" target="_blank" rel="noopener">Plugin Repo</a></li>
            <li><a href="https://github.com/vipintom/vstack-openchamber" target="_blank" rel="noopener">OpenChamber Repo</a></li>
            <li><a href={withBase('/compatibility/')}>Compatibility Matrix</a></li>
          </ul>
        </article>
      </div>
    </Container>
  </Section>

  <Search />
</Landing>

<style>
  .hero-section { padding: var(--space-4xl) 0; min-height: calc(100dvh - var(--banner-height)); display: flex; align-items: center; max-width: var(--container); margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap-columns); align-items: center; width: 100%; max-width: var(--container); margin: 0 auto; }
  @media (max-width: 1024px) { .hero-grid { grid-template-columns: 1fr; text-align: center; } }
  .hero-text h1 { font-size: clamp(3rem, 8vw, 5rem); font-weight: 700; margin-bottom: var(--space-md); color: var(--color-ink); }
  .hero-sentence { font-size: clamp(1.125rem, 2vw, 1.5rem); color: var(--color-ink-muted); margin-bottom: var(--space-xl); max-width: 60ch; line-height: 1.5; }
  .hero-actions { display: flex; gap: var(--gap-columns); flex-wrap: wrap; margin-bottom: var(--space-2xl); }
  @media (max-width: 1024px) { .hero-actions { justify-content: center; } }
  .hero-visual { min-height: 900px; display: flex; align-items: center; justify-content: center; }
  .hero-visual .arch-svg { width: 100%; height: auto; max-width: 100%; }

  /* Hero button overrides - ensure proper height and padding */
  .hero-actions .btn { min-height: 48px; height: 48px; padding: 0 32px; }
  .hero-actions .btn:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .hero-actions .btn:active:not(:disabled) { transform: scale(0.98); }
  .hero-actions .btn-primary { background: var(--color-accent); color: var(--color-accent-ink); }
  .hero-actions .btn-primary:hover:not(:disabled) { background: var(--color-accent-hover); }
  .hero-actions .btn-secondary { background: transparent; color: var(--color-ink); border-color: var(--color-rule); }
  .hero-actions .btn-secondary:hover:not(:disabled) { background: var(--color-paper-2); border-color: var(--color-ink-muted); }

  .section-header { text-align: center; margin-bottom: var(--space-xl); max-width: var(--container); margin-left: auto; margin-right: auto; padding: 0 var(--gutter); }
  .section-header h2 { font-size: var(--text-section); margin-bottom: var(--space-sm); }
  .section-lead { color: var(--color-ink-muted); max-width: var(--container); margin: 0 auto; padding: 0 var(--gutter); }

  /* Add visual mass to sections */
  .section-header::before { content: ""; display: block; width: 60px; height: 4px; background: var(--color-accent); margin: 0 auto var(--space-md); border-radius: var(--radius-full); }

  .matrix-controls { display: flex; gap: var(--gap-columns); margin-bottom: var(--space-xl); flex-wrap: wrap; justify-content: center; }
  .matrix-controls > * { flex: 1; max-width: 300px; }

  .matrix-table-wrap { background: var(--color-paper-2); border: 1px solid var(--color-rule); border-radius: var(--radius-lg); padding: var(--space-lg); }
  .matrix-table-wrap td:first-child { white-space: nowrap; }

  .pillars-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap-columns); }
  @media (max-width: 1024px) { .pillars-grid { grid-template-columns: 1fr; } }
  .pillar-card { background: var(--color-paper-2); border: 1px solid var(--color-rule); border-radius: var(--radius-lg); padding: var(--space-xl); display: flex; flex-direction: column; min-height: 300px; }
  .pillar-card .card-title { font-size: var(--text-title); font-weight: 600; margin-bottom: var(--space-md); color: var(--color-ink); }
  .pillar-card .card-desc { color: var(--color-ink-muted); margin-bottom: var(--space-lg); flex: 1; }
  .pillar-card .card-badges { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-bottom: var(--space-lg); }

  .arch-layers { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--gap-columns); }
  .arch-layer { border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-2xl); background: var(--color-surface); }
  .arch-layer summary { font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; padding: var(--space-sm) 0; }
  .arch-layer summary::marker { content: none; }
  .layer-count { color: var(--color-ink-muted); font-size: 0.875rem; }
  .layer-skills { list-style: none; padding: 0; margin: var(--space-md) 0 0; }
  .layer-skills li { margin-bottom: var(--space-xs); }
  .layer-skills a { color: var(--color-primary); text-decoration: none; }
  .layer-skills a:hover { text-decoration: underline; }

  .arch-layers-wrap { background: var(--color-paper-2); border: 1px solid var(--color-rule); border-radius: var(--radius-lg); padding: var(--space-xl); }

  .arch-diagram { overflow-x: auto; margin: var(--space-xl) 0; }
  .arch-svg { max-width: 100%; height: auto; display: block; margin: 0 auto; }
  .arch-legend { display: flex; flex-wrap: wrap; gap: var(--gap-columns); justify-content: center; margin-top: var(--space-lg); }
  .legend-item { display: flex; align-items: center; gap: var(--space-sm); font-size: 0.875rem; color: var(--color-ink-muted); }
  .legend-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }

  .arch-text-alternative { margin: var(--space-xl) 0; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .arch-text-alternative summary { padding: var(--space-md) var(--space-lg); font-weight: 600; cursor: pointer; color: var(--color-primary); }
  .arch-text-alternative summary::marker { content: none; }
  .arch-text-alternative summary::-webkit-details-marker { display: none; }
  .arch-text-alternative[open] summary { border-bottom: 1px solid var(--color-border); }
  .arch-text-content { padding: var(--space-lg); max-width: 800px; margin: 0 auto; }
  .arch-text-content h3 { margin-top: 0; margin-bottom: var(--space-lg); font-size: var(--text-title); }
  .arch-text-content h4 { margin-top: var(--space-xl); margin-bottom: var(--space-md); font-size: var(--text-md); color: var(--color-ink); }
  .arch-text-content ul { margin: var(--space-md) 0; padding-left: var(--space-xl); }
  .arch-text-content li { margin-bottom: var(--space-sm); line-height: 1.6; }
  .arch-text-content p { margin: var(--space-md) 0; line-height: 1.6; }
  .arch-text-content strong { color: var(--color-ink); }
  .arch-text-content em { color: var(--color-accent); font-style: italic; }
  @media (max-width: 600px) { .arch-text-content { padding: var(--space-md); } }

  .install-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: var(--gap-columns); }
  .install-card { border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); background: var(--color-surface); }
  .install-card h3 { margin-top: 0; margin-bottom: var(--space-md); }

  .install-wrap { background: var(--color-paper-2); border: 1px solid var(--color-rule); border-radius: var(--radius-lg); padding: var(--space-xl); }
  .install-card p { font-size: 0.875rem; color: var(--color-ink-muted); margin: var(--space-md) 0 0; }

  .ref-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--gap-columns); }
  .ref-card { border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); background: var(--color-surface); }
  .ref-card h3 { margin-top: 0; margin-bottom: var(--space-md); font-size: 1.125rem; }
  .ref-card ul { list-style: none; padding: 0; margin: 0; }
  .ref-card li { margin-bottom: var(--space-sm); }
  .ref-card a { color: var(--color-primary); text-decoration: none; white-space: nowrap; }
  .ref-card a:hover { text-decoration: underline; }
</style>

<script set:html>
  // Theme toggle persistence - IIFE to avoid SSR issues
  (() => {
    const toggle = document.getElementById('theme-toggle');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
    const stored = localStorage.getItem('theme');
    const isDark = stored ? stored === 'dark' : prefersDark.matches;

    document.documentElement.classList.toggle('dark', isDark);
    if (toggle) toggle.setAttribute('aria-pressed', isDark);

    if (toggle) {
      toggle.addEventListener('click', () => {
        const newDark = !document.documentElement.classList.contains('dark');
        document.documentElement.classList.toggle('dark', newDark);
        localStorage.setItem('theme', newDark ? 'dark' : 'light');
        toggle.setAttribute('aria-pressed', newDark);
      });
    }
  })();

  // Capability matrix search + filter
  (() => {
    const searchInput = document.getElementById('matrix-search');
    const categoryFilter = document.getElementById('matrix-category-filter');
    const table = document.querySelector('[data-capability-table]');
    if (!table) return;

    const rows = table.querySelectorAll('tbody tr');
    const filter = () => {
      const search = searchInput?.value?.toLowerCase() || '';
      const category = categoryFilter?.value || '';
      rows.forEach(row => {
        const name = row.cells[0]?.textContent?.toLowerCase() || '';
        const cat = row.cells[1]?.textContent || '';
        const matchSearch = name.includes(search);
        const matchCategory = !category || cat === category;
        row.style.display = (matchSearch && matchCategory) ? '' : 'none';
      });
    };
    searchInput?.addEventListener('input', filter);
    categoryFilter?.addEventListener('change', filter);
  })();

  // Copy buttons for code blocks
  (() => {
    document.querySelectorAll('[data-copy-btn]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-code') || '';
        try {
          await navigator.clipboard.writeText(code);
          const original = btn.textContent;
          btn.textContent = btn.getAttribute('data-success') || 'Copied!';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = original;
            btn.classList.remove('copied');
          }, 2000);
        } catch (e) {
          console.error('Copy failed:', e);
        }
      });
    });
  })();
</script><!-- auto-deploy test -->
