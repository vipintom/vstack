---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import Card from '@components/Card.astro';
import CodeBlock from '@components/CodeBlock.astro';
import { openchamberProduct } from '@data/products';
import { productIntros } from '@data/editorial';
import { withBase } from '../../utils/urls';
---

<Doc title={openchamberProduct.identity.name} description={openchamberProduct.identity.shortDescription}>
  <Section id="openchamber" gap="l" aria-labelledby="openchamber-title">
    <Container>
      <h1 id="openchamber-title">{openchamberProduct.identity.name}</h1>
      <p class="lead">{openchamberProduct.identity.description}</p>

      <div class="pillar-grid">
        <Card 
          title="Notes" 
          description="Project notes and documentation" 
          actionLabel="View Notes" 
          actionHref={withBase('/openchamber/notes/')} 
          badgeLabels={["Read-only"]} 
          badgeVariants={["info"]} 
        />
        <Card 
          title="Todos" 
          description="Task tracking and progress" 
          actionLabel="View Todos" 
          actionHref={withBase('/openchamber/todos/')} 
          badgeLabels={["Read-only"]} 
          badgeVariants={["pass"]} 
        />
        <Card 
          title="Plans" 
          description="Project plans and roadmaps" 
          actionLabel="View Plans" 
          actionHref={withBase('/openchamber/plans/')} 
          badgeLabels={["Read-only"]} 
          badgeVariants={["warn"]} 
        />
      </div>

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <h2>About</h2>
      <p>OpenChamber is a local-first project knowledge management tool. The vstack-openchamber package provides a read-only React panel that visualizes project Notes, Todos, and Plans stored in OpenChamber's JSON format.</p>

      <h2 style="margin-top: var(--space-2xl);">Installation</h2>
      {openchamberProduct.installation.map(inst => (
        <>
          <h3>{inst.name}</h3>
          <CodeBlock code={inst.command} language="bash" showCopy={true} copyLabel="Copy" copySuccess="Copied!" />
          <p style="font-size: var(--text-sm); color: var(--color-ink-muted); margin-top: var(--space-sm);">{inst.description}</p>
          {inst.prerequisites.length > 0 && (
            <p style="font-size: var(--text-sm); color: var(--color-ink-muted); margin-top: var(--space-xs);"><strong>Prerequisites:</strong> {inst.prerequisites.join(', ')}</p>
          )}
          {inst.dependencies.length > 0 && (
            <ul style="font-size: var(--text-sm); color: var(--color-ink-muted); margin-top: var(--space-xs);">
              {inst.dependencies.map(dep => (
                <li><strong>{dep.name}</strong> ({dep.type}): {dep.description}</li>
              ))}
            </ul>
          )}
        </>
      ))}

      <h2 style="margin-top: var(--space-2xl);">Repository</h2>
      <p><a href="https://github.com/vipintom/vstack-openchamber" target="_blank" rel="noopener">github.com/vipintom/vstack-openchamber</a></p>
    </Container>
  </Section>
</Doc>

<style>
  .pillar-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--gap-columns); }
  @media (max-width: 768px) { .pillar-grid { grid-template-columns: 1fr; } }
</style>