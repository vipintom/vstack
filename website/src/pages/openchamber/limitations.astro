---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import CodeBlock from '@components/CodeBlock.astro';
import DataTable from '@components/DataTable.astro';
---

<Doc title="OpenChamber Limitations" description="Known limitations and constraints of the vstack OpenChamber extension">
  <Section id="limitations" gap="l" aria-labelledby="limit-title">
    <Container>
      <h1 id="limit-title">OpenChamber Limitations</h1>
      <p class="lead">Understanding the current constraints helps set expectations and plan workarounds.</p>

      <h2>Architectural Limitations</h2>

      <DataTable
        columns={[
          { key: 'limitation', header: 'Limitation', sortable: true },
          { key: 'impact', header: 'Impact', sortable: false },
          { key: 'workaround', header: 'Workaround', sortable: false },
          { key: 'status', header: 'Status', sortable: false },
        ]}
        data={[
          ['Read-only', 'Cannot modify workflow state', 'Use OpenCode tools for mutations', 'By design'],
          ['Projections only', 'Cannot access raw delivery/task/evidence files', 'Projections contain all needed data', 'By design'],
          ['Polling-based', '3s delay for updates', 'Manual refresh button available', 'Planned: WebSocket'],
          ['Single project', 'One .vstack/ directory per OpenChamber window', 'Open separate windows for multiple projects', 'Known'],
          ['Protocol v1 only', 'Future v2 projections not readable', 'Plugin publishes both during transition', 'Planned'],
        ]}
        emptyState={false}
      />

      <h2 style="margin-top: var(--space-2xl);">Data Limitations</h2>

      <DataTable
        columns={[
          { key: 'limitation', header: 'Limitation', sortable: true },
          { key: 'details', header: 'Details', sortable: false },
        ]}
        data={[
          ['No phase detail in delivery report', 'Phases array is empty in v1 projection; use OpenCode for phase details'],
          ['No real-time streaming', 'Polling interval minimum 1s (configured 3s)'],
          ['No cross-delivery queries', 'Each delivery report is independent'],
          ['Limited memory visualization', 'Memory index shows categories only, not full content'],
          ['No custom dashboard layouts', 'Fixed tab structure: Overview, Quality, Reviews, Releases, Evidence'],
          ['No export functionality', 'Cannot export views as PDF/CSV'],
        ]}
        emptyState={false}
      />

      <h2 style="margin-top: var(--space-2xl);">UI/UX Limitations</h2>

      <DataTable
        columns={[
          { key: 'limitation', header: 'Limitation', sortable: true },
          { key: 'details', header: 'Details', sortable: false },
        ]}
        data={[
          ['No keyboard shortcuts', 'Tab switching requires mouse/touch'],
          ['No column sorting in tables', 'Data displayed in projection order'],
          ['No filtering in tables', 'All rows shown; use browser find (Ctrl+F)'],
          ['Fixed color scheme', 'Follows OpenChamber theme only'],
          ['No density settings', 'Compact/normal row density not configurable'],
          ['Limited mobile support', 'Designed for desktop; panel may be cramped on mobile'],
        ]}
        emptyState={false}
      />

      <h2 style="margin-top: var(--space-2xl);">Performance Limitations</h2>

      <DataTable
        columns={[
          { key: 'limitation', header: 'Limitation', sortable: true },
          { key: 'threshold', header: 'Threshold', sortable: false },
          { key: 'impact', header: 'Impact', sortable: false },
        ]}
        data={[
          ['Large delivery reports', '> 100 tasks', 'Slow render, high memory'],
          ['Many deliveries', '> 50 active', 'Dashboard index load slow'],
          ['Deep activity history', '> 1000 events', 'Activity tab slow'],
          ['Frequent polling', '< 1000ms interval', 'CPU usage, file system pressure'],
        ]}
        emptyState={false}
      />

      <h2 style="margin-top: var(--space-2xl);">Integration Limitations</h2>

      <DataTable
        columns={[
          { key: 'limitation', header: 'Limitation', sortable: true },
          { key: 'details', header: 'Details', sortable: false },
        ]}
        data={[
          ['OpenChamber only', 'Does not work in VS Code, browser, or other hosts'],
          ['No API for embedding', 'Cannot embed dashboard in other apps'],
          ['No webhook/callback', 'Cannot trigger external actions on changes'],
          ['Single extension instance', 'Cannot run multiple vstack panels simultaneously'],
        ]}
        emptyState={false}
      />

      <h2 style="margin-top: var(--space-2xl);">Planned Improvements</h2>

      <DataTable
        columns={[
          { key: 'improvement', header: 'Improvement', sortable: true },
          { key: 'target', header: 'Target Version', sortable: false },
          { key: 'details', header: 'Details', sortable: false },
        ]}
        data={[
          ['WebSocket real-time updates', '0.2.0', 'Replace polling with push notifications'],
          ['Protocol v2 support', '0.2.0', 'Backward compatible with v1'],
          ['Phase detail in projections', '0.2.0', 'Add phases to delivery-detail-report'],
          ['Export to CSV/JSON', '0.3.0', 'Download current view data'],
          ['Customizable columns', '0.3.0', 'Show/hide/reorder table columns'],
          ['Keyboard navigation', '0.3.0', 'Full keyboard accessibility'],
          ['Cross-delivery views', '0.4.0', 'Aggregate views across deliveries'],
        ]}
        emptyState={false}
      />
    </Container>
  </Section>
</Doc>