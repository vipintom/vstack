---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro'
import CodeBlock from '@components/CodeBlock.astro';
import DataTable from '@components/DataTable.astro';
---

<Doc title="OpenChamber Troubleshooting" description="Troubleshooting guide for the vstack OpenChamber extension">
  <Section id="troubleshooting" gap="l" aria-labelledby="ts-title">
    <Container>
      <h1 id="ts-title">OpenChamber Troubleshooting</h1>
      <p class="lead">Common issues and solutions for the vstack workflow visualization extension.</p>

      <h2>Quick Diagnostic</h2>
      <CodeBlock code="# Check OpenChamber version\nopenchamber --version\n\n# Check extension loaded\n# OpenChamber Settings → Extensions → vstack Workflow\n\n# Check files permission\n# Settings → Capabilities → Files → Should show 'Granted'\n\n# Check projections exist\nls -la .vstack/reports/\nls -la .vstack/state/" language="bash" showCopy={true} />

      <h2 style="margin-top: var(--space-2xl);">Common Issues</h2>

      <DataTable
        columns={[
          { key: 'issue', header: 'Issue', sortable: true },
          { key: 'cause', header: 'Root Cause', sortable: false },
          { key: 'solution', header: 'Solution', sortable: false },
        ]}
        data={[
          ['Panel shows "No project open"', 'No .vstack/ directory in current project', 'Run vstack workflow in this project first, or open a project with .vstack/'],
          ['Panel shows "Files permission denied"', 'Files capability not granted', 'OpenChamber Settings → Capabilities → Files → Grant'],
          ['Panel shows "Unsupported schema version"', 'Manifest schemaVersion !== 1', 'Check .vstack/manifest.json; ensure OpenCode plugin v0.1.0+'],
          ['Panel shows "No vstack workflow found"', 'Manifest missing or invalid', 'Verify .vstack/manifest.json exists and has schemaVersion: 1'],
          ['Panel shows "No active workflow state"', 'Dashboard index missing', 'Run vstack_projection publish --all from OpenCode'],
          ['Dashboard empty / no deliveries', 'No deliveries created', 'Create delivery: vstack_delivery create --title "My Work" --objective "..." --createdBy "user"'],
          ['Data not updating', 'Polling not working', 'Click Refresh button; check browser console for errors'],
          ['Extension not appearing in Panels', 'Extension not enabled', 'Settings → Extensions → vstack Workflow → Enable'],
          ['Page "vstack Dashboard" not appearing', 'Extension page not registered', 'Restart OpenChamber after enabling extension'],
          ['Theme not applying', 'Theme sync issue', 'Refresh OpenChamber; check body[data-theme] in DevTools'],
        ]}
        emptyState={false}
      />

      <h2 style="margin-top: var(--space-2xl);">Debugging Steps</h2>

      <h3>1. Verify Projections Exist</h3>
      <CodeBlock code="# Required files\nls .vstack/manifest.json\nls .vstack/state/index.json\nls .vstack/reports/deliveries/\n\n# Check manifest content\ncat .vstack/manifest.json | jq .\n\n# Check index content\ncat .vstack/state/index.json | jq ." language="bash" showCopy={true} />

      <h3>2. Check Browser Console</h3>
      <ol>
        <li>Open OpenChamber DevTools (Ctrl+Shift+I)</li>
        <li>Go to Console tab</li>
        <li>Look for errors from vstack Workflow panel</li>
        <li>Common errors:
          <ul>
            <li><code>NOT_GRANTED</code> → Files permission denied</li>
            <li><code>Failed to load dashboard</code> → Check network tab for failed file reads</li>
            <li><code>Unsupported schema version</code> → Manifest schema mismatch</li>
          </ul>
        </li>
      </ol>

      <h3>3. Verify OpenCode Plugin</h3>
      <CodeBlock code="# In OpenCode session\nvstack_status\nvstack_status --projections\nvstack_projection status\n\n# Force republish\nvstack_projection publish --all" language="bash" showCopy={true} />

      <h3>4. Check File Permissions</h3>
      <CodeBlock code="# Verify .vstack is readable\nls -la .vstack/\nls -la .vstack/reports/\nls -la .vstack/state/\n\n# Check file ownership\nstat .vstack/manifest.json" language="bash" showCopy={true} />

      <h2 style="margin-top: var(--space-2xl);">Error Reference</h2>

      <DataTable
        columns={[
          { key: 'error', header: 'Error Message', sortable: true },
          { key: 'location', header: 'Where', sortable: false },
          { key: 'fix', header: 'Fix', sortable: false },
        ]}
        data={[
          ['NOT_GRANTED: files', 'Browser console / panel UI', 'Grant Files capability in OpenChamber Settings'],
          ['Unsupported schema version: 2', 'Panel UI', 'Update OpenChamber extension to support v2, or downgrade OpenCode plugin'],
          ['Failed to load dashboard', 'Browser console', 'Check projections exist; verify file permissions'],
          ['Delivery report not found', 'Delivery Detail tab', 'Run vstack_projection publish --delivery <id>'],
          ['No active deliveries', 'Overview tab', 'Create a delivery in OpenCode'],
          ['Permission denied reading .vstack/', 'Browser console', 'Fix file permissions; ensure OpenChamber has read access'],
        ]}
        emptyState={false}
      />

      <h2 style="margin-top: var(--space-2xl);">Reset Procedures</h2>

      <h3>Soft Reset (Clear Cache)</h3>
      <ol>
        <li>Close OpenChamber</li>
        <li>Delete browser cache for OpenChamber origin</li>
        <li>Reopen OpenChamber</li>
      </ol>

      <h3>Hard Reset (Reinstall Extension)</h3>
      <CodeBlock code="# Disable extension in OpenChamber Settings\n# Remove extension\n# Reinstall via Extension Manager or manual build\n# Grant Files capability again" language="bash" showCopy={true} />

      <h3>Projection Reset</h3>
      <CodeBlock code="# In OpenCode session\nvstack_projection publish --all --force\n\n# Or delete and regenerate\nrm -rf .vstack/reports .vstack/state\nvstack_projection publish --all" language="bash" showCopy={true} />

      <h2 style="margin-top: var(--space-2xl);">Getting Help</h2>
      <ul>
        <li><strong>GitHub Issues:</strong> <a href="https://github.com/vipintom/vstack-openchamber/issues">vipintom/vstack-openchamber/issues</a></li>
        <li><strong>OpenChamber Discord:</strong> #extensions channel</li>
        <li><strong>vstack Documentation:</strong> <a href="/openchamber/">OpenChamber Docs</a></li>
        <li><strong>OpenCode Plugin Issues:</strong> <a href="https://github.com/vipintom/vstack-opencode/issues">vipintom/vstack-opencode/issues</a> (for projection generation issues)</li>
      </ul>

      <h2 style="margin-top: var(--space-2xl);">Reporting Bugs</h2>
      <p>When filing an issue, include:</p>
      <ol>
        <li>OpenChamber version (<code>openchamber --version</code>)</li>
        <li>Extension version (from Settings → Extensions)</li>
        <li>OpenCode plugin version (<code>vstack_status</code>)</li>
        <li>Browser console errors (screenshot or copy)</li>
        <li>Reproduction steps</li>
        <li>Relevant projection files (sanitized)</li>
      </ol>
    </Container>
  </Section>
</Doc>