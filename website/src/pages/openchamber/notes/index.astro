---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import CodeBlock from '@components/CodeBlock.astro';
import { noteExample } from '@data/openchamber-examples';
import { withBase } from '../../../utils/urls';
---

<Doc title="Notes - OpenChamber" description="Project notes and documentation">
  <Section id="notes" gap="l" aria-labelledby="notes-title">
    <Container>
      <h1 id="notes-title">Notes</h1>
      <p class="lead">Project notes and documentation from OpenChamber.</p>

      <div class="placeholder-content">
        <p>Notes content will be populated from OpenChamber project data.</p>
        <CodeBlock code={noteExample} language="json" />
      </div>

      <p style="margin-top: var(--space-xl);"><a href={withBase('/openchamber/')}>← Back to OpenChamber</a></p>
    </Container>
  </Section>
</Doc>

<style>
  .placeholder-content { border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); background: var(--color-surface); }
  .placeholder-content p { margin-top: 0; margin-bottom: var(--space-lg); color: var(--color-ink-muted); }
</style>