---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import CodeBlock from '@components/CodeBlock.astro';
import Card from '@components/Card.astro';
import Badge from '@components/Badge.astro';
import DataTable from '@components/DataTable.astro';
import { openchamberProduct } from '@data/products';
import { withBase } from '../../utils/urls';
---

<Doc title="OpenChamber Installation" description="Install the vstack OpenChamber extension for workflow visualization">
  <Section id="installation" gap="l" aria-labelledby="install-title">
    <Container>
      <h1 id="install-title">OpenChamber Installation</h1>
      <p class="lead">Install the vstack OpenChamber extension for read-only workflow visualization.</p>

      <!-- Overview -->
      <div class="overview-card">
        <h2>What You're Installing</h2>
        <p>OpenChamber is a <strong>read-only visualization extension</strong> for the OpenChamber platform. It provides a Panel (sidebar) and Dashboard (full-page) that display projections published by the vstack OpenCode Plugin.</p>
        <ul style="margin: var(--space-md) 0; padding-left: var(--space-xl);">
          <li><strong>Panel</strong> — Sidebar showing deliveries, tasks, quality, activity, memory</li>
          <li><strong>Dashboard</strong> — Full-page view with detailed workflow state</li>
          <li><strong>Read-only</strong> — Never mutates runtime state</li>
          <li><strong>Distribution</strong> — Git URL or built ZIP (not on npm)</li>
        </ul>
      </div>

      <!-- Prerequisites -->
      <div class="prerequisites-box">
        <h2>Prerequisites</h2>
        <ul>
          <li><strong>OpenChamber host ≥1.24.0</strong> — Extension host application</li>
          <li><strong>@openchamber/sdk@2.5.3</strong> — Required for panel/page development</li>
          <li><strong>vstack OpenCode Plugin ≥0.1.0</strong> — Must be publishing projections to <code>.vstack/</code></li>
          <li><strong>Project with <code>.vstack/</code></strong> — Projections directory must exist</li>
        </ul>
      </div>

      <!-- Installation Methods -->
      <h2>Installation Methods</h2>

      {openchamberProduct.installation.map(inst => (
        <article class="install-method">
          <header class="method-header">
            <h3>{inst.name}</h3>
            <Badge variant={inst.verification === 'documentation-verified' ? 'pass' : 'info'}>{inst.verification}</Badge>
          </header>

          <CodeBlock code={inst.command} language="bash" showCopy={true} copyLabel="Copy" copySuccess="Copied!" />

          {inst.prerequisites.length > 0 && (
            <div class="prerequisites">
              <h4>Prerequisites</h4>
              <ul>
                {inst.prerequisites.map(p => <li>{p}</li>)}
              </ul>
            </div>
          )}

          {inst.dependencies.length > 0 && (
            <details class="dependencies">
              <summary>Required Dependencies</summary>
              <ul>
                {inst.dependencies.map(dep => (
                  <li><strong>{dep.name}</strong> ({dep.type}): {dep.description} <CodeBlock code={dep.package + (dep.version ? '@' + dep.version : '')} language="bash" inline={true} /></li>
                ))}
              </ul>
            </details>
          )}

          <div class="doc-link">
            <a href={inst.documentationUrl} target="_blank" rel="noopener">Documentation →</a>
          </div>
        </article>
      ))}

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <!-- Method 1: Extension Manager (expanded) -->
      <h2>Method 1: Extension Manager (Recommended)</h2>
      <ol class="steps">
        <li>Open OpenChamber Settings → Extensions</li>
        <li>Click "Install from URL" or "Install from Git"</li>
        <li>Enter: <code>https://github.com/vipintom/vstack-openchamber.git</code></li>
        <li>Enable the extension</li>
        <li>Restart OpenChamber if prompted</li>
      </ol>

      <!-- Method 2: Manual Build (expanded) -->
      <h2 id="manual-build" style="margin-top: var(--space-2xl);">Method 2: Manual Build</h2>
      <CodeBlock code="# Clone the repository\ngit clone https://github.com/vipintom/vstack-openchamber.git\ncd vstack-openchamber\n\n# Install dependencies\npnpm install\n\n# Build the extension\npnpm build\n\n# In OpenChamber Settings → Extensions → Load Unpacked\n# Select the panel/ directory" language="bash" showCopy={true} copyLabel="Copy" copySuccess="Copied!" />

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <!-- Required Permissions -->
      <h2>Required Permissions</h2>
      <p>The extension requires the <strong>Files</strong> capability to read projections from <code>.vstack/</code>:</p>

      <ol class="steps">
        <li>Open OpenChamber Settings → Capabilities</li>
        <li>Find "Files" in the list</li>
        <li>Click "Grant" or "Allow"</li>
        <li>Confirm the permission dialog</li>
      </ol>

      <div class="warning-box">
        <p><strong>Without this permission</strong>, the panel will show "Files permission denied" error and cannot read projections.</p>
      </div>

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <!-- Verification -->
      <h2>Verification</h2>
      <p>After installation, verify the extension loads:</p>

      <ol class="steps">
        <li>Open a project with vstack projections (<code>.vstack/reports/</code> exists)</li>
        <li>Open the sidebar → Panels → "vstack Workflow"</li>
        <li>You should see delivery overview, tasks, quality, activity, memory</li>
        <li>Also check Pages → "vstack Dashboard" for full-screen view</li>
      </ol>

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <!-- Configuration -->
      <h2>Configuration</h2>
      <p>The extension auto-discovers <code>.vstack/</code> in the current project. No configuration needed.</p>

      <DataTable
        columns={[
          { key: 'setting', header: 'Setting', sortable: true },
          { key: 'description', header: 'Description', sortable: false },
          { key: 'default', header: 'Default', sortable: false },
        ]}
        data={[
          ['Poll Interval', 'Auto-refresh interval (ms)', '3000'],
          ['Schema Version', 'Supported projection protocol', 'v1'],
          ['Theme', 'Follows OpenChamber theme', 'Auto'],
        ]}
        emptyState={false}
      />

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <!-- Supported Versions -->
      <h2>Supported OpenChamber Versions</h2>

      <DataTable
        columns={[
          { key: 'version', header: 'OpenChamber', sortable: true },
          { key: 'status', header: 'Support', sortable: false },
          { key: 'notes', header: 'Notes', sortable: false },
        ]}
        data={[
          ['≥ 1.24.0', 'Full Support', 'All features work'],
          ['1.20.0 - 1.23.x', 'Partial', 'Panel works, page may have issues'],
          ['< 1.20.0', 'Not Supported', 'Extension API incompatible'],
        ]}
        emptyState={false}
      />

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <!-- Navigation -->
      <div class="nav-links">
        <a href={withBase('/install/')} class="btn-secondary">← Back to Installation Overview</a>
        <a href={withBase('/install/opencode-plugin/')} class="btn-secondary">← OpenCode Plugin</a>
        <a href={withBase('/openchamber/')} class="btn-primary">OpenChamber Overview →</a>
      </div>
    </Container>
  </Section>
</Doc>

<style>
  .lead {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    margin: var(--space-md) 0 0;
  }

  .overview-card {
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }
  .overview-card h3 { margin: 0 0 var(--space-md); }

  .prerequisites-box {
    background: var(--color-paper-2);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }
  .prerequisites-box h3 { margin: 0 0 var(--space-md); color: var(--color-accent); }
  .prerequisites-box ul { margin: 0; padding-left: var(--space-xl); }
  .prerequisites-box li { margin-bottom: var(--space-sm); }

  .install-method {
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .method-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .method-header h3 { margin: 0; font-size: var(--text-lg); }

  .prerequisites {
    margin: var(--space-md) 0;
    padding: var(--space-md);
    background: var(--color-paper-2);
    border-radius: var(--radius-md);
  }
  .prerequisites h4 { margin: 0 0 var(--space-sm); font-size: var(--text-sm); color: var(--color-ink-muted); }
  .prerequisites ul { margin: 0; padding-left: var(--space-xl); font-size: var(--text-sm); }

  .dependencies summary { cursor: pointer; color: var(--color-primary); font-size: var(--text-sm); margin-bottom: var(--space-sm); }
  .dependencies ul { margin: 0; padding-left: var(--space-xl); font-size: var(--text-sm); color: var(--color-ink-muted); }
  .dependencies li { margin-bottom: var(--space-xs); }

  .doc-link { margin-top: var(--space-md); font-size: var(--text-sm); }
  .doc-link a { color: var(--color-primary); }

  .steps {
    margin: var(--space-md) 0;
    padding-left: var(--space-xl);
  }
  .steps li { margin-bottom: var(--space-sm); }

  .warning-box {
    background: var(--color-warning, oklch(65% 0.18 85 / 0.1));
    border: 1px solid var(--color-warning, oklch(65% 0.18 85 / 0.3));
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    margin: var(--space-md) 0;
  }
  .warning-box p { margin: 0; color: var(--color-warning); }

  .nav-links {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
</style>