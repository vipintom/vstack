---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import SearchInput from '@components/SearchInput.astro';
import Badge from '@components/Badge.astro';
import Button from '@components/Button.astro';
import { capabilityData, capabilityCategories, harnessSummary, getCapabilitiesByComponent } from '@data/capabilities';
import { withBase } from '../../utils/urls';

// Get all unique categories and statuses
const allCategories = [...new Set(capabilityData.capabilities.map(c => c.category))].sort();
const allStatuses = ['full', 'partial', 'planned', 'none', 'unknown'] as const;

const componentLabels = {
  playbook: 'Playbook (55 skills)',
  opencode: 'OpenCode Plugin (23 tools)',
  openchamber: 'OpenChamber (2 interfaces)',
};

// Initial component
const initialComponent = 'playbook';
const initialCapabilities = getCapabilitiesByComponent(initialComponent);

// Helper to render status badge class
function statusBadgeClass(status: string): string {
  return `badge-${status}`;
}
---

<Doc title="Capability Explorer" description="Browse all vstack capabilities across Playbook, OpenCode Plugin, and OpenChamber. Filter by component, category, status, and search by name.">
  <Section id="capabilities" gap="l" aria-labelledby="capabilities-title">
    <Container>
      <header class="section-header">
        <h1 id="capabilities-title">Capability Explorer</h1>
        <p class="section-lead">Unified view of all vstack capabilities. <strong>{capabilityData.summary.total}</strong> total capabilities across <strong>3 components</strong> and <strong>{capabilityCategories.length} categories</strong>.</p>
      </header>

      <!-- Component Selector Tabs (server-rendered, default to Playbook) -->
      <div class="component-tabs" role="tablist" aria-label="Select component">
        <button role="tab" aria-selected="true" data-component="playbook" class="tab-btn active" disabled>
          <span class="tab-icon" aria-hidden="true">PB</span>
          <span class="tab-label">Playbook</span>
          <span class="tab-count">{capabilityData.summary.byComponent.playbook}</span>
        </button>
        <button role="tab" aria-selected="false" data-component="opencode" class="tab-btn" disabled>
          <span class="tab-icon" aria-hidden="true">OC</span>
          <span class="tab-label">OpenCode Plugin</span>
          <span class="tab-count">{capabilityData.summary.byComponent.opencode}</span>
        </button>
        <button role="tab" aria-selected="false" data-component="openchamber" class="tab-btn" disabled>
          <span class="tab-icon" aria-hidden="true">CH</span>
          <span class="tab-label">OpenChamber</span>
          <span class="tab-count">{capabilityData.summary.byComponent.openchamber}</span>
        </button>
      </div>

      <div class="component-note">
        <p>Component switching requires JavaScript. Currently showing: <strong>Playbook</strong> capabilities. Use the filters below to explore.</p>
      </div>

      <!-- Filters -->
      <div class="filters-bar">
        <div class="filter-group">
          <SearchInput
            placeholder="Search capabilities…"
            aria-label="Search capabilities by name or description"
            id="capability-search"
          />
        </div>
        
        <div class="filter-group">
          <label for="category-filter" class="filter-label">Category</label>
          <select id="category-filter" class="filter-select" aria-label="Filter by category">
            <option value="">All Categories</option>
            {allCategories.map(cat => (
              <option value={cat}>{cat} ({capabilityData.summary.byCategory[cat] || 0})</option>
            ))}
          </select>
        </div>

        <div class="filter-group">
          <label for="status-filter" class="filter-label">Status</label>
          <select id="status-filter" class="filter-select" aria-label="Filter by status">
            <option value="">All Statuses</option>
            {allStatuses.map(status => (
              <option value={status}>{status.charAt(0).toUpperCase() + status.slice(1)}</option>
            ))}
          </select>
        </div>

        <div class="filter-group">
          <label for="component-filter" class="filter-label">Component</label>
          <select id="component-filter" class="filter-select" aria-label="Filter by component">
            <option value="">All Components</option>
            <option value="playbook">Playbook</option>
            <option value="opencode">OpenCode Plugin</option>
            <option value="openchamber">OpenChamber</option>
          </select>
        </div>
      </div>

      <!-- Results Summary -->
      <div class="results-summary" aria-live="polite">
        <span id="results-count">{initialCapabilities.length} capabilities</span>
        <span id="active-filters" class="active-filters" hidden></span>
      </div>

      <!-- Capability Grid - Server rendered for all components -->
      <div id="capability-grid" class="capability-grid" aria-label="Capabilities">
        {['playbook', 'opencode', 'openchamber'].map(component => {
          const capabilities = getCapabilitiesByComponent(component);
          return (
            <div data-component={component} class="component-section" style={component !== 'playbook' ? 'display: none;' : ''}>
              <h2 class="component-section-title">{componentLabels[component]}</h2>
              <div class="component-list" role="list" aria-label={componentLabels[component]}>
                {capabilities.map(cap => (
                  <div 
                    class="capability-card" 
                    role="listitem"
                    data-capability-id={cap.id}
                    data-category={cap.category}
                    data-status={cap.status.opencode}
                    data-component={cap.component}
                    data-name={cap.name.toLowerCase()}
                    data-description={cap.description.toLowerCase()}
                  >
                    <header class="card-header">
                      <div class="card-title-row">
                        <h3 class="card-name">{cap.name}</h3>
                        <span class="card-category">{cap.category}</span>
                      </div>
                      <p class="card-description">{cap.description}</p>
                    </header>
                    <div class="card-status">
                      <span class="status-label">OpenCode:</span>
                      <span class="status-badge"><Badge variant={cap.status.opencode}>{cap.status.opencode}</Badge></span>
                      <span class="status-label">Codex:</span>
                      <span class="status-badge"><Badge variant={cap.status.codex}>{cap.status.codex}</Badge></span>
                      <span class="status-label">Claude Code:</span>
                      <span class="status-badge"><Badge variant={cap.status.claudeCode}>{cap.status.claudeCode}</Badge></span>
                    </div>
                    {cap.notes && <p class="card-notes">{cap.notes}</p>}
                    <footer class="card-footer">
                      {cap.documentationRef && (
                        <a href={withBase(cap.documentationRef)} class="doc-link" target="_blank" rel="noopener">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                            <line x1="16" y1="13" x2="8" y2="13"/>
                            <line x1="16" y1="17" x2="8" y2="17"/>
                            <polyline points="10 9 9 9 8 9"/>
                          </svg>
                          Documentation
                        </a>
                      )}
                      <button class="detail-btn" data-capability-id={cap.id} aria-label={"View details for " + cap.name} disabled>Details</button>
                    </footer>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <!-- No Results State -->
      <div id="no-results" class="no-results" hidden>
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="M21 21l-4.35-4.35"/>
        </svg>
        <h3>No capabilities match your filters</h3>
        <p>Try adjusting your search or filter criteria</p>
        <Button id="clear-filters-btn" variant="secondary" disabled>Clear All Filters</Button>
      </div>

      <!-- Capability Detail Modal -->
      <dialog id="capability-detail" class="detail-modal" aria-labelledby="detail-title">
        <div class="modal-content">
          <header class="modal-header">
            <h2 id="detail-title">Capability Details</h2>
            <button class="modal-close" aria-label="Close dialog" disabled>&times;</button>
          </header>
          <div class="modal-body" id="modal-body">
            <p>Detail view requires JavaScript.</p>
          </div>
        </div>
      </dialog>

      <!-- Embedded capability data for future client-side enhancement -->
      <script id="capability-data" type="application/json" set:html={JSON.stringify(capabilityData.capabilities)} />

      <!-- Harness Support Summary -->
      <details class="harness-summary" open>
        <summary>Harness Support Summary (Playbook Skills)</summary>
        <div class="harness-grid">
          {harnessSummary.map(h => (
            <article class="harness-card">
              <h3>{h.harness}</h3>
              <div class="status-counts">
                <span class="status-count pass"><Badge variant="pass">Full: {h.full}</Badge></span>
                <span class="status-count partial"><Badge variant="warn">Partial: {h.partial}</Badge></span>
                <span class="status-count planned"><Badge variant="info">Planned: {h.planned}</Badge></span>
                <span class="status-count none"><Badge variant="fail">None: {h.none}</Badge></span>
              </div>
            </article>
          ))}
        </div>
      </details>

      <!-- Source Provenance -->
      <details class="provenance-info">
        <summary>Data Source & Provenance</summary>
        <div class="provenance-content">
          <p><strong>Source:</strong> {capabilityData.provenance.repository} / {capabilityData.provenance.path}</p>
          <p><strong>Revision:</strong> {capabilityData.provenance.revision}</p>
          <p><strong>Verified:</strong> {capabilityData.provenance.verifiedAt}</p>
          <p><strong>Release Context:</strong> vstack-2026.11.03</p>
          <p>All capabilities include per-harness status (OpenCode, Codex, Claude Code) and documentation references.</p>
        </div>
      </details>
    </Container>
  </Section>
</Doc>

<style>
  .section-header {
    margin-bottom: var(--space-xl);
  }
  .section-lead {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    margin: var(--space-md) 0 0;
  }

  /* Component Tabs */
  .component-tabs {
    display: flex;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
    border-bottom: 2px solid var(--color-rule);
    padding-bottom: var(--space-sm);
    flex-wrap: wrap;
  }
  .tab-btn {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    transition: all var(--dur-micro) var(--ease-out);
  }
  .tab-btn:hover:not(:disabled) {
    background: var(--color-paper-2);
    border-color: var(--color-ink-muted);
    color: var(--color-ink);
  }
  .tab-btn.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }
  .tab-btn.active .tab-count {
    background: var(--color-accent-ink);
    color: var(--color-accent);
  }
  .tab-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .tab-icon { font-size: var(--text-md); }
  .tab-count {
    background: var(--color-paper-2);
    color: var(--color-ink-muted);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .tab-btn.active .tab-icon { filter: brightness(1.2); }

  .component-note {
    margin-bottom: var(--space-lg);
    padding: var(--space-md);
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .component-note strong { color: var(--color-ink); }

  /* Filters Bar */
  .filters-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-columns);
    align-items: flex-end;
    margin-bottom: var(--space-lg);
    padding: var(--space-lg);
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
  }
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 160px;
    flex: 1;
  }
  .filter-group:first-child {
    flex: 2;
    min-width: 280px;
  }
  .filter-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-body);
    color: var(--color-ink-muted);
  }
  .filter-select {
    height: 40px;
    padding: 0 var(--space-md);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink);
    background: var(--color-paper-2);
    border: 2px solid var(--color-rule);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color var(--dur-micro) var(--ease-out);
  }
  .filter-select:focus {
    outline: none;
    border-color: var(--color-focus);
    box-shadow: 0 0 0 3px oklch(55% 0.22 35 / 0.2);
  }

  /* Results Summary */
  .results-summary {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .active-filters {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
  }

  /* Capability Grid */
  .capability-grid {
    margin-bottom: var(--space-xl);
  }
  .component-section { margin-bottom: var(--space-2xl); }
  .component-section-title {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0 0 var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink);
  }
  .capability-card {
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all var(--dur-short) var(--ease-out);
  }
  .capability-card:hover {
    background: var(--color-paper-3);
    border-color: var(--color-ink-muted);
    box-shadow: var(--shadow-card);
  }
  .capability-card[hidden] {
    display: none;
  }

  .card-header { margin-bottom: var(--space-md); }
  .card-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-xs);
    flex-wrap: wrap;
  }
  .card-name {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    margin: 0;
  }
  .card-category {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    background: var(--color-paper);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-xs);
    white-space: nowrap;
  }
  .card-description {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin: 0;
    line-height: 1.5;
    flex: 1;
  }
  .card-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin: var(--space-md) 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule);
  }
  .status-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
    text-transform: uppercase;
  }
  .status-badge .badge { font-size: var(--text-xs); }
  .card-notes {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    font-style: italic;
    margin: var(--space-sm) 0;
  }
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule);
  }
  .doc-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-primary);
    text-decoration: none;
  }
  .doc-link:hover { text-decoration: underline; }
  .detail-btn {
    height: 36px;
    padding: 0 var(--space-md);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--dur-micro) var(--ease-out);
  }
  .detail-btn:hover:not(:disabled) {
    background: var(--color-primary);
    color: var(--color-primary-foreground);
  }
  .detail-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* No Results */
  .no-results {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-3xl);
    text-align: center;
    color: var(--color-ink-muted);
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    margin-top: var(--space-xl);
  }
  .no-results svg { margin-bottom: var(--space-lg); opacity: 0.5; }
  .no-results h3 { margin: 0 0 var(--space-sm); font-size: var(--text-xl); color: var(--color-ink); }
  .no-results p { margin: 0 0 var(--space-lg); }

  /* Detail Modal */
  .detail-modal {
    border: none;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-modal);
    max-width: 600px;
    width: 90vw;
    max-height: 85vh;
    overflow: hidden;
  }
  .detail-modal::backdrop {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }
  .modal-content {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
  }
  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg);
    border-bottom: 1px solid var(--color-rule);
  }
  .modal-header h2 { margin: 0; font-size: var(--text-xl); }
  .modal-close {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    font-size: var(--text-2xl);
    color: var(--color-ink-muted);
    cursor: pointer;
    border-radius: var(--radius-sm);
  }
  .modal-close:hover { background: var(--color-paper-2); color: var(--color-ink); }
  .modal-close:disabled { opacity: 0.5; cursor: not-allowed; }
  .modal-body {
    padding: var(--space-lg);
    overflow-y: auto;
    max-height: 60vh;
  }

  /* Harness Summary */
  .harness-summary {
    margin-top: var(--space-2xl);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-paper);
  }
  .harness-summary summary {
    padding: var(--space-md) var(--space-lg);
    font-weight: 600;
    cursor: pointer;
    color: var(--color-primary);
  }
  .harness-summary summary::marker { content: none; }
  .harness-summary summary::-webkit-details-marker { display: none; }
  .harness-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--gap-columns);
    padding: 0 var(--space-lg) var(--space-lg);
  }
  .harness-card h3 { margin: var(--space-lg) 0 var(--space-md); font-size: var(--text-md); }
  .status-counts { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .status-count { display: flex; align-items: center; }

  /* Provenance */
  .provenance-info {
    margin-top: var(--space-xl);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-paper);
  }
  .provenance-info summary {
    padding: var(--space-md) var(--space-lg);
    font-weight: 600;
    cursor: pointer;
    color: var(--color-primary);
  }
  .provenance-info summary::marker { content: none; }
  .provenance-info summary::-webkit-details-marker { display: none; }
  .provenance-content {
    padding: 0 var(--space-lg) var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .provenance-content p { margin: var(--space-sm) 0; }
  .provenance-content a { color: var(--color-primary); }

  /* Responsive */
  @media (max-width: 768px) {
    .filters-bar { flex-direction: column; align-items: stretch; }
    .filter-group { width: 100%; min-width: 0; }
    .filter-group:first-child { min-width: 0; }
    .capability-grid { grid-template-columns: 1fr; }
    .component-tabs { justify-content: center; }
  }
  @media (max-width: 480px) {
    .card-status { gap: var(--space-xs); }
    .status-label { display: none; }
    .detail-btn { padding: 0 var(--space-sm); font-size: var(--text-xs); }
  }
</style>