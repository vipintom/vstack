---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import CodeBlock from '@components/CodeBlock.astro';
import Card from '@components/Card.astro';
import Badge from '@components/Badge.astro';
import { playbookProduct } from '@data/products';
import { withBase } from '../../utils/urls';
---

<Doc title="Playbook Skills Installation" description="Install vstack Playbook skills for your AI harness">
  <Section id="installation" gap="l" aria-labelledby="install-title">
    <Container>
      <h1 id="install-title">Playbook Skills Installation</h1>
      <p class="lead">Install the vstack Playbook (55 skills, 18 workflows, 17 principles) for your AI harness.</p>

      <!-- Overview -->
      <div class="overview-card">
        <h3>What You're Installing</h3>
        <p>The vstack Playbook is a portable methodology package. It installs as <strong>skills</strong> into your AI harness, making 55 reusable procedures available as <code>vstack-*</code> commands.</p>
        <ul style="margin: var(--space-md) 0; padding-left: var(--space-xl);">
          <li><strong>55 Skills</strong> across 13 categories</li>
          <li><strong>18 Workflows</strong> for common scenarios</li>
          <li><strong>17 Principles</strong> for engineering decisions</li>
          <li><strong>Zero runtime code</strong> — pure Markdown/YAML</li>
        </ul>
      </div>

      <!-- Installation Methods -->
      <h2>Installation Methods</h2>

      {playbookProduct.installation.map(inst => (
        <article class="install-method">
          <header class="method-header">
            <h3>{inst.name}</h3>
            <Badge variant={inst.verification === 'documentation-verified' ? 'pass' : 'info'}>{inst.verification}</Badge>
          </header>

          <CodeBlock code={inst.command} language="bash" showCopy={true} copyLabel="Copy" copySuccess="Copied!" />

          {inst.prerequisites.length > 0 && (
            <div class="prerequisites">
              <h4>Prerequisites</h4>
              <ul>
                {inst.prerequisites.map(p => <li>{p}</li>)}
              </ul>
            </div>
          )}

          {inst.dependencies.length > 0 && (
            <details class="dependencies">
              <summary>Required Dependencies</summary>
              <ul>
                {inst.dependencies.map(dep => (
                  <li><strong>{dep.name}</strong> ({dep.type}): {dep.description} <CodeBlock code={dep.package + (dep.version ? '@' + dep.version : '')} language="bash" inline={true} /></li>
                ))}
              </ul>
            </details>
          )}

          <div class="doc-link">
            <a href={inst.documentationUrl} target="_blank" rel="noopener">Documentation →</a>
          </div>
        </article>
      ))}

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <!-- Verification -->
      <h2>Verification</h2>
      <p>After installation, verify skills are available:</p>

      <CodeBlock code={`# List all vstack skills
opencode skill list | grep vstack

# Verify specific skill
opencode skill info vstack:using-superpowers

# Check version
opencode skill info vstack | grep version`} language="bash" showCopy={true} copyLabel="Copy" copySuccess="Copied!" />

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <!-- Troubleshooting -->
      <h2>Troubleshooting</h2>

      <details class="troubleshooting">
        <summary>Skill installation fails</summary>
        <ul>
          <li>Ensure your harness supports skills (OpenCode ≥2.2.0, Codex with skills config, Claude Code with skills field)</li>
          <li>Check network connectivity to npm/GitHub</li>
          <li>Restart the harness and retry</li>
        </ul>
      </details>

      <details class="troubleshooting">
        <summary>Skills not appearing after install</summary>
        <ul>
          <li>Restart your AI harness completely</li>
          <li>Check <code>~/.config/opencode/skills/vstack/</code> exists and has content</li>
          <li>Run <code>opencode skill list</code> to see all installed skills</li>
        </ul>
      </details>

      <details class="troubleshooting">
        <summary>Version conflicts</summary>
        <ul>
          <li>Remove old version first: <code>opencode skill remove vstack</code></li>
          <li>Clear harness cache if available</li>
          <li>Reinstall with explicit version if needed</li>
        </ul>
      </details>

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <!-- Navigation -->
      <div class="nav-links">
        <a href={withBase('/install/')} class="btn-secondary">← Back to Installation Overview</a>
        <a href={withBase('/install/opencode-plugin/')} class="btn-primary">Next: OpenCode Plugin →</a>
      </div>
    </Container>
  </Section>
</Doc>

<style>
  .lead {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    margin: var(--space-md) 0 0;
  }

  .overview-card {
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }
  .overview-card h3 { margin: 0 0 var(--space-md); }

  .install-method {
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .method-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .method-header h3 { margin: 0; font-size: var(--text-lg); }

  .prerequisites {
    margin: var(--space-md) 0;
    padding: var(--space-md);
    background: var(--color-paper-2);
    border-radius: var(--radius-md);
  }
  .prerequisites h4 { margin: 0 0 var(--space-sm); font-size: var(--text-sm); color: var(--color-ink-muted); }
  .prerequisites ul { margin: 0; padding-left: var(--space-xl); font-size: var(--text-sm); }

  .dependencies summary { cursor: pointer; color: var(--color-primary); font-size: var(--text-sm); margin-bottom: var(--space-sm); }
  .dependencies ul { margin: 0; padding-left: var(--space-xl); font-size: var(--text-sm); color: var(--color-ink-muted); }
  .dependencies li { margin-bottom: var(--space-xs); }

  .doc-link { margin-top: var(--space-md); font-size: var(--text-sm); }
  .doc-link a { color: var(--color-primary); }

  .troubleshooting {
    margin-bottom: var(--space-md);
    padding: var(--space-md);
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
  }
  .troubleshooting summary { cursor: pointer; font-weight: 600; color: var(--color-ink); }
  .troubleshooting ul { margin: var(--space-md) 0 0; padding-left: var(--space-xl); }
  .troubleshooting li { margin-bottom: var(--space-xs); font-size: var(--text-sm); }

  .nav-links {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
</style>