---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import CodeBlock from '@components/CodeBlock.astro';
import DataTable from '@components/DataTable.astro';
import { withBase } from '../../utils/urls';
---

<Doc title="Remove vstack" description="Completely remove vstack skills, plugin, and data from your system">
  <Section id="removal" gap="l" aria-labelledby="removal-title">
    <Container>
      <h1 id="removal-title">Remove vstack</h1>
      <p class="lead">Complete removal procedures for vstack components. Choose the level of removal you need.</p>

      <div class="nav-links" style="margin-bottom: var(--space-2xl);">
        <a href={withBase('/install/')} class="btn-secondary">← Installation Overview</a>
        <a href={withBase('/install/upgrade/')} class="btn-secondary">Upgrade →</a>
      </div>

      <!-- Quick Removal (Skills Only) -->
      <h2>Quick Removal (Skills Only)</h2>
      <p>Remove just the vstack skills from your AI harness, keeping project data intact:</p>

      <CodeBlock code={`# OpenCode
opencode skill remove vstack

# Codex
codex skill remove vstack

# Claude Code
claude skill remove vstack`} language="bash" showCopy={true} copyLabel="Copy" copySuccess="Copied!" />

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <!-- Full Removal (Plugin + Data) -->
      <h2>Full Removal (Plugin + Data)</h2>
      <p>Remove everything including the OpenCode plugin and all project workflow data:</p>

      <div class="removal-step">
        <h3>1. Remove OpenCode Plugin</h3>
        <CodeBlock code={`# Uninstall npm package (from project)
npm uninstall @vipintom/vstack-opencode

# If installed globally
npm uninstall -g @vipintom/vstack-opencode

# Remove skills
opencode skill remove vstack`} language="bash" showCopy={true} copyLabel="Copy" copySuccess="Copied!" />
      </div>

      <div class="removal-step">
        <h3>2. Remove Project Data (<code>.vstack/</code>)</h3>
        <div class="warning-box">
          <p><strong>⚠️ WARNING:</strong> This deletes ALL workflow history, deliveries, tasks, evidence, memory, and checkpoints. <strong>Cannot be undone.</strong></p>
        </div>
        <CodeBlock code={`# In each project directory
rm -rf .vstack

# Or remove from all projects (use with caution)
find . -name '.vstack' -type d -exec rm -rf {} +`} language="bash" showCopy={true} copyLabel="Copy" copySuccess="Copied!" />
      </div>

      <div class="removal-step">
        <h3>3. Remove OpenChamber Extension</h3>
        <ol>
          <li>Open OpenChamber Settings → Extensions</li>
          <li>Find "vstack Workflow"</li>
          <li>Click "Remove" or "Uninstall"</li>
          <li>Restart OpenChamber</li>
        </ol>
      </div>

      <div class="removal-step">
        <h3>4. Remove Global Config (Optional)</h3>
        <CodeBlock code={`# Remove global vstack config (if exists)
rm -rf ~/.config/vstack

# Remove OpenCode skill cache
rm -rf ~/.config/opencode/skills/vstack`} language="bash" showCopy={true} copyLabel="Copy" copySuccess="Copied!" />
      </div>

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <!-- Selective Removal -->
      <h2>Selective Removal</h2>
      <p>Remove only specific components:</p>

      <DataTable
        columns={[
          { key: 'component', header: 'Component', sortable: true },
          { key: 'command', header: 'Removal Command', sortable: false },
          { key: 'preserves', header: 'Preserves', sortable: false },
        ]}
        data={[
          ['Skills only', 'opencode skill remove vstack', 'Project data, plugin, OpenChamber'],
          ['Plugin only', 'npm uninstall @vipintom/vstack-opencode', 'Skills, project data, OpenChamber'],
          ['Project data only', 'rm -rf .vstack', 'Skills, plugin, OpenChamber'],
          ['OpenChamber only', 'Extension Manager → Remove', 'Skills, plugin, project data'],
          ['Everything', 'All of the above', 'Nothing'],
        ]}
        emptyState={false}
      />

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <!-- Verification -->
      <h2>Verification</h2>
      <p>Confirm complete removal:</p>

      <CodeBlock code={`# Check skills gone
opencode skill list | grep -i vstack || echo 'No vstack skills found'

# Check plugin gone
npm list @vipintom/vstack-opencode 2>&1 | grep -q 'not found' && echo 'Plugin not installed'

# Check project data gone
ls .vstack 2>&1 | grep -q 'No such file' && echo 'No .vstack directory'

# Check OpenChamber
echo 'Check OpenChamber Settings → Extensions manually'`} language="bash" showCopy={true} copyLabel="Copy" copySuccess="Copied!" />

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <!-- Troubleshooting Removal -->
      <h2>Troubleshooting Removal</h2>

      <DataTable
        columns={[
          { key: 'issue', header: 'Issue', sortable: true },
          { key: 'solution', header: 'Solution', sortable: false },
        ]}
        data={[
          ['Skill remove fails', 'Restart OpenCode/Codex/Claude Code and retry'],
          ['Plugin files locked', 'Close all OpenCode sessions before npm uninstall'],
          ['.vstack permission denied', 'sudo rm -rf .vstack (if ownership issue)'],
          ['Extension won\'t remove', 'Restart OpenChamber, then remove from Settings'],
          ['Residual config', 'Check ~/.config/vstack, ~/.vstack, project root for leftovers'],
        ]}
        emptyState={false}
      />

      <hr style="margin: var(--space-3xl) 0; border: none; border-top: 1px solid var(--color-rule);">

      <!-- Reinstall After Removal -->
      <h2>Reinstall After Removal</h2>
      <p>To reinstall fresh after removal:</p>

      <CodeBlock code={`# Fresh install (skills)
opencode skill install vstack

# Fresh install (plugin)
npm install @vipintom/vstack-opencode@latest
opencode skill install vstack

# Verify
vstack_status
vstack_status --tools`} language="bash" showCopy={true} copyLabel="Copy" copySuccess="Copied!" />

      <div class="nav-links">
        <a href={withBase('/install/')} class="btn-secondary">← Installation Overview</a>
        <a href={withBase('/install/upgrade/')} class="btn-secondary">← Upgrade</a>
      </div>
    </Container>
  </Section>
</Doc>

<style>
  .lead {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    margin: var(--space-md) 0 0;
  }

  .nav-links {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .removal-step {
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    margin-bottom: var(--space-xl);
  }
  .removal-step h3 { margin: 0 0 var(--space-md); }

  .warning-box {
    background: var(--color-error, oklch(55% 0.22 25 / 0.1));
    border: 1px solid var(--color-error, oklch(55% 0.22 25 / 0.3));
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    margin: var(--space-md) 0;
  }
  .warning-box p { margin: 0; color: var(--color-error); }
</style>