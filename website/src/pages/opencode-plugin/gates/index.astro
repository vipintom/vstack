---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import Card from '@components/Card.astro';
import Badge from '@components/Badge.astro';
import { sidebarItems } from '@data/opencode-tools';
import { gateCardProps, emptyState, docTitle, docDescription, docSidebarTitle } from '@data/opencode-gates-cards';
---

<Doc title={docTitle} description={docDescription} sidebarTitle={docSidebarTitle} sidebarItems={sidebarItems}>
  <Section id="gates-index" gap="l" aria-labelledby="gates-title">
    <Container>
      <h1 id="gates-title">Gates</h1>
      <p class="lead">Quality gates that enforce standards: verification, review, security, performance, and more.</p>

      <div class="gates-grid">
        {gateCardProps.map(props => <Card {...props} />)}
      </div>

      {emptyState && (
        <div class="empty-state">
          <p>No gates found.</p>
        </div>
      )}
    </Container>
  </Section>
</Doc>

<style>
  .gates-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--gap-columns); }
  @media (max-width: 768px) { .gates-grid { grid-template-columns: 1fr; } }
  .empty-state { text-align: center; color: var(--color-ink-muted); padding: var(--space-3xl); }
</style>