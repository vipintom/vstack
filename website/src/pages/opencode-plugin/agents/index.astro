---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import Card from '@components/Card.astro';
import Badge from '@components/Badge.astro';
import { sidebarItems } from '@data/opencode-tools';
import { agentCardProps, emptyState, docTitle, docDescription, docSidebarTitle } from '@data/opencode-agents-cards';
---

<Doc title={docTitle} description={docDescription} sidebarTitle={docSidebarTitle} sidebarItems={sidebarItems}>
  <Section id="agents-index" gap="l" aria-labelledby="agents-title">
    <Container>
      <h1 id="agents-title">Agents</h1>
      <p class="lead">Specialist agents: Builder (implementation), Reviewer (verification), Lead (coordination).</p>

      <div class="agents-grid">
        {agentCardProps.map(props => <Card {...props} />)}
      </div>

      {emptyState && (
        <div class="empty-state">
          <p>No agents found. The OpenCode plugin includes 3 built-in agents:</p>
          <ul>
            <li><strong>Builder</strong> - Implements features using TDD</li>
            <li><strong>Reviewer</strong> - Verifies implementations against acceptance criteria</li>
            <li><strong>Lead</strong> - Coordinates multi-agent workflows</li>
          </ul>
        </div>
      )}
    </Container>
  </Section>
</Doc>

<style>
  .agents-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--gap-columns); }
  @media (max-width: 768px) { .agents-grid { grid-template-columns: 1fr; } }
  .empty-state { text-align: center; color: var(--color-ink-muted); padding: var(--space-3xl); }
  .empty-state ul { text-align: left; max-width: 400px; margin: var(--space-lg) auto; padding-left: var(--space-xl); }
</style>