---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import CodeBlock from '@components/CodeBlock.astro';
import Card from '@components/Card.astro';
import DataTable from '@components/DataTable.astro';
---

<Doc title="OpenCode Plugin Configuration" description="Configure the vstack OpenCode plugin: settings, environment variables, and behavior options">
  <Section id="configuration" gap="l" aria-labelledby="config-title">
    <Container>
      <h1 id="config-title">OpenCode Plugin Configuration</h1>
      <p class="lead">Configure the vstack OpenCode plugin to match your project's workflow requirements.</p>

      <h2>Installation & Setup</h2>
      <p>Install the plugin via npm and it will auto-register with OpenCode:</p>
      <CodeBlock code="npm install @vipintom/vstack-opencode" language="bash" showCopy={true} />
      
      <p>OpenCode discovers the plugin automatically via its <code>package.json</code> entry point. No additional configuration is required for basic usage.</p>

      <h2 style="margin-top: var(--space-2xl);">Environment Variables</h2>
      <p>The plugin respects the following environment variables:</p>

      <DataTable
        columns={[
          { key: 'name', header: 'Variable', sortable: true },
          { key: 'description', header: 'Description', sortable: false },
          { key: 'default', header: 'Default', sortable: false },
        ]}
        data={[
          ['VSTACK_ROOT', 'Override the .vstack directory location', 'Auto-detected (repo root)'],
          ['VSTACK_PROFILE', 'Default delivery profile', 'feature'],
          ['VSTACK_PERMISSIONS', 'Permission level: minimal, standard, elevated', 'standard'],
          ['VSTACK_LOG_LEVEL', 'Logging verbosity: debug, info, warn, error', 'info'],
          ['VSTACK_PROJECTIONS_ENABLED', 'Enable projection publishing', 'true'],
          ['VSTACK_PROJECTION_INTERVAL', 'Projection publish interval (ms)', '3000'],
        ]}
        emptyState={false}
      />

      <h2 style="margin-top: var(--space-2xl);">Configuration File</h2>
      <p>Create <code>.vstack/config.json</code> at your project root for persistent configuration:</p>

      <CodeBlock code={`{
  "schemaVersion": 1,
  "projectId": "my-project",
  "defaultProfile": "feature",
  "permissions": "standard",
  "projections": {
    "enabled": true,
    "intervalMs": 3000,
    "reports": ["delivery", "activity", "quality", "memory"]
  },
  "requiredChecks": [
    "lint",
    "test",
    "typecheck"
  ],
  "approvals": {
    "complete_delivery": true,
    "delete_delivery": true,
    "override_completion_gate": true
  }
}`} language="json" showCopy={true} copyLabel="Copy config template" />

      <h2 style="margin-top: var(--space-2xl);">Profiles</h2>
      <p>Profiles define preset configurations for different types of work:</p>

      <DataTable
        columns={[
          { key: 'profile', header: 'Profile', sortable: true },
          { key: 'description', header: 'Description', sortable: false },
          { key: 'phases', header: 'Default Phases', sortable: false },
          { key: 'gates', header: 'Required Gates', sortable: false },
        ]}
        data={[
          ['feature', 'New feature development', 'planning, implementation, verification, review', 'test, lint, typecheck'],
          ['bugfix', 'Bug fix workflow', 'diagnosis, fix, verification', 'test, lint'],
          ['refactor', 'Code refactoring', 'analysis, refactor, verification, review', 'test, lint, typecheck'],
          ['migration', 'Data/schema migration', 'planning, migration, verification, rollback', 'test, lint, verification'],
          ['infrastructure', 'Infrastructure changes', 'planning, apply, verification', 'lint, security'],
          ['documentation', 'Documentation updates', 'draft, review, publish', 'lint'],
          ['operations', 'Operational tasks', 'planning, execution, verification', 'none'],
          ['release', 'Release preparation', 'planning, staging, verification, deploy', 'test, lint, security, verification'],
          ['other', 'Custom workflow', 'configurable', 'configurable'],
        ]}
        emptyState={false}
      />

      <h2 style="margin-top: var(--space-2xl);">Required Checks Configuration</h2>
      <p>Define mandatory checks in <code>.vstack/required-checks.json</code> that must pass before task/delivery completion:</p>

      <CodeBlock code={`{
  "schemaVersion": 1,
  "checks": [
    {
      "id": "lint",
      "name": "Lint Check",
      "command": "npm run lint",
      "required": true,
      "provenance": "plugin_observed"
    },
    {
      "id": "test",
      "name": "Test Suite",
      "command": "npm test",
      "required": true,
      "provenance": "plugin_observed"
    },
    {
      "id": "typecheck",
      "name": "TypeScript Check",
      "command": "tsc --noEmit",
      "required": true,
      "provenance": "plugin_observed"
    }
  ]
}`} language="json" showCopy={true} copyLabel="Copy" />

      <h2 style="margin-top: var(--space-2xl);">Validation</h2>
      <p>Validate your configuration:</p>
      <CodeBlock code={`# Check config syntax
vstack_status

# View active configuration
vstack_tool discovery --action config`} language="bash" showCopy={true} copyLabel="Copy" />
    </Container>
  </Section>
</Doc>