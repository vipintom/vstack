---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import CodeBlock from '@components/CodeBlock.astro';
import DataTable from '@components/DataTable.astro';

const approvalRecordJson = `{
  "schemaVersion": 1,
  "id": "apr_abc123",
  "deliveryId": "dlv_xyz789",
  "action": "complete_delivery",
  "targetId": "dlv_xyz789",
  "scope": "complete_delivery:dlv_xyz789",
  "requestedBy": "agent_builder",
  "requestedAt": "2026-11-04T10:00:00.000Z",
  "status": "granted",
  "grantedBy": "human_user",
  "grantedAt": "2026-11-04T10:05:00.000Z",
  "reason": "All gates passed",
  "scopeHash": "sha256(complete_delivery:dlv_xyz789)"
}`;

const approvalPath = '.vstack/approvals/{approvalId}.json';
---

<Doc title="OpenCode Plugin Permissions" description="Understand the vstack OpenCode plugin permission model, approval scopes, and autonomy levels">
  <Section id="permissions" gap="l" aria-labelledby="perm-title">
    <Container>
      <h1 id="perm-title">OpenCode Plugin Permissions</h1>
      <p class="lead">The vstack OpenCode plugin uses a permission model that balances agent autonomy with human oversight.</p>

      <h2>Permission Levels</h2>
      <p>Set via <code>VSTACK_PERMISSIONS</code> or <code>.vstack/config.json</code>:</p>

      <DataTable
        columns={[
          { key: 'level', header: 'Level', sortable: true },
          { key: 'description', header: 'Description', sortable: false },
          { key: 'actions', header: 'Allowed Without Approval', sortable: false },
          { key: 'requiresApproval', header: 'Requires Approval', sortable: false },
        ]}
        data={[
          ['minimal', 'Read-only access + task creation', 'vstack_status, vstack_task create, vstack_memory read', 'All completion, deletion, override actions'],
          ['standard', 'Full workflow execution (default)', 'All reads, task/delivery CRUD, agent dispatch, check execution', 'complete_delivery, delete_delivery, override_completion_gate, approve_*'],
          ['elevated', 'Full autonomy including admin actions', 'All standard + approval overrides, destructive migrations, rollbacks', 'Only approve_destructive_migration, approve_rollback'],
        ]}
        emptyState={false}
      />

      <h2 style="margin-top: var(--space-2xl);">Protected Actions</h2>
      <p>These actions require explicit approval regardless of permission level (configurable in <code>.vstack/config.json</code>):</p>

      <DataTable
        columns={[
          { key: 'action', header: 'Action', sortable: true },
          { key: 'description', header: 'Description', sortable: false },
          { key: 'scope', header: 'Scope', sortable: false },
        ]}
        data={[
          ['complete_delivery', 'Mark a delivery as completed', 'Per-delivery'],
          ['complete_task', 'Mark a task as completed', 'Per-task'],
          ['mark_delivery_blocked', 'Set delivery status to blocked', 'Per-delivery'],
          ['mark_task_blocked', 'Set task status to blocked', 'Per-task'],
          ['delete_delivery', 'Delete a delivery and all its data', 'Per-delivery'],
          ['delete_task', 'Delete a task', 'Per-task'],
          ['override_completion_gate', 'Bypass a completion gate', 'Per-gate'],
          ['approve_release', 'Approve a release candidate', 'Per-release'],
          ['approve_deployment', 'Approve a deployment', 'Per-deployment'],
          ['approve_destructive_migration', 'Approve a destructive data migration', 'Per-migration'],
          ['approve_rollback', 'Approve a rollback', 'Per-rollback'],
          ['approve_scope_change', 'Approve delivery scope changes', 'Per-delivery'],
        ]}
        emptyState={false}
      />

      <h2 style="margin-top: var(--space-2xl);">Approval Flow</h2>
      <ol>
        <li>Agent requests protected action via tool</li>
        <li>Plugin checks <code>requiresApproval(action)</code> → returns true</li>
        <li>Tool returns error with <code>action</code> and <code>targetId</code></li>
        <li>Human reviews and grants/denies via <code>vstack_approval</code> tool</li>
        <li>Agent retries action; plugin validates <code>validateApprovalScope</code></li>
        <li>Action executes if approval valid and scope matches</li>
      </ol>

      <CodeBlock code={`# Request approval for completing a delivery
vstack_approval --action complete_delivery --target dlv_abc123 --grant --reason "All gates passed"

# List pending approvals
vstack_approval --list

# View approval history
vstack_approval --history`} language="bash" showCopy={true} copyLabel="Copy" />

      <h2 style="margin-top: var(--space-2xl);">Approval Records</h2>
      <p>Approvals are stored in <code>{approvalPath}</code> with scope binding:</p>

      <CodeBlock code={approvalRecordJson} language="json" showCopy={true} copyLabel="Copy" />

      <p><strong>Scope binding:</strong> Each approval is cryptographically bound to its action and target via SHA256. An approval for <code>complete_delivery:dlv_xyz789</code> cannot be reused for <code>complete_delivery:dlv_other</code>.</p>

      <h2 style="margin-top: var(--space-2xl);">Agent Autonomy</h2>
      <p>Agents operate within their permission level:</p>

      <DataTable
        columns={[
          { key: 'role', header: 'Agent Role', sortable: true },
          { key: 'autonomy', header: 'Autonomy Level', sortable: false },
          { key: 'canDispatch', header: 'Can Dispatch', sortable: false },
          { key: 'notes', header: 'Notes', sortable: false },
        ]}
        data={[
          ['Builder', 'Standard', 'No', 'Implements tasks; requests completions'],
          ['Reviewer', 'Standard', 'No', 'Verifies work; records findings'],
          ['Lead', 'Elevated', 'Yes', 'Coordinates; can override gates with approval'],
        ]}
        emptyState={false}
      />

      <h2 style="margin-top: var(--space-2xl);">Best Practices</h2>
      <ul>
        <li>Use <strong>standard</strong> for most projects — balances speed and safety</li>
        <li>Reserve <strong>elevated</strong> for trusted automated pipelines</li>
        <li>Configure <code>required-checks.json</code> to enforce quality before completions</li>
        <li>Review approval logs regularly: <code>vstack_approval --history</code></li>
        <li>Set <code>VSTACK_PERMISSIONS=minimal</code> for read-only CI environments</li>
      </ul>
    </Container>
  </Section>
</Doc>