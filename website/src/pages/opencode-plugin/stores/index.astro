---
import Doc from '@layouts/Doc.astro';
import Container from '@components/Container.astro';
import Section from '@components/Section.astro';
import Card from '@components/Card.astro';
import Badge from '@components/Badge.astro';
import { sidebarItems } from '@data/opencode-tools';
import { storeCardProps, emptyState, docTitle, docDescription, docSidebarTitle } from '@data/opencode-stores-cards';
---

<Doc title={docTitle} description={docDescription} sidebarTitle={docSidebarTitle} sidebarItems={sidebarItems}>
  <Section id="stores-index" gap="l" aria-labelledby="stores-title">
    <Container>
      <h1 id="stores-title">Stores</h1>
      <p class="lead">Persistent state stores for delivery tracking, history, memory, quality, and sessions.</p>

      <div class="stores-grid">
        {storeCardProps.map(props => <Card {...props} />)}
      </div>

      {emptyState && (
        <div class="empty-state">
          <p>No stores found.</p>
        </div>
      )}
    </Container>
  </Section>
</Doc>

<style>
  .stores-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--gap-columns); }
  @media (max-width: 768px) { .stores-grid { grid-template-columns: 1fr; } }
  .empty-state { text-align: center; color: var(--color-ink-muted); padding: var(--space-3xl); }
</style>