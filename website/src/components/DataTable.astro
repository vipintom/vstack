---
interface Props {
  columns: Array<{ key: string; label: string; sortable?: boolean; render?: (value: any, row: any) => any; pinned?: boolean }>;
  data: any[];
  searchKey?: string;
  class?: string;
}
const { columns, data, searchKey, class: className = '' } = Astro.props;
---

<div class="table-wrap {className}" role="region" aria-label="Data table" tabindex="0">
  <table>
    <thead>
      <tr>
        {columns.map(col => (
          <th scope="col" class={col.pinned ? 'pinned' : ''} style={col.sortable ? 'cursor: pointer;' : ''}>
            {col.label}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {data.map(row => (
        <tr>
          {columns.map(col => (
            <td class={col.pinned ? 'pinned' : ''} data-key={col.key}>
              {col.render ? col.render(row[col.key], row) : row[col.key]}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .table-wrap { overflow-x: auto; width: 100%; border: 1px solid var(--color-rule); border-radius: var(--radius-sm); }
  table { width: 100%; border-collapse: collapse; font-family: var(--font-mono); font-size: var(--text-sm); line-height: 1.5; }
  th { text-align: left; font-weight: 600; color: var(--color-ink-muted); padding: var(--space-sm) var(--space-md); border-bottom: 2px solid var(--color-rule); white-space: nowrap; background: var(--color-paper-2); position: sticky; top: 0; z-index: var(--z-sticky); }
  td { padding: var(--space-sm) var(--space-md); border-bottom: 1px solid var(--color-rule); vertical-align: top; }
  tbody tr:hover td { background: var(--color-paper-2); }
  tbody tr:last-child td { border-bottom: none; }
  td.pinned { font-weight: 500; background: var(--color-paper); position: sticky; left: 0; z-index: var(--z-raised); border-right: 1px solid var(--color-rule); }
  th.pinned { position: sticky; left: 0; z-index: calc(var(--z-sticky) + 1); }
  @media (max-width: 600px) { table { min-width: 600px; } }
</style>