---
import Badge from './Badge.astro';

interface Props {
  harnessSummary: Array<{
    harness: string;
    full: number;
    partial: number;
    planned: number;
    none: number;
  }>;
}

const { harnessSummary } = Astro.props;
---

<!-- Harness Support Summary -->
<details class="harness-summary" open>
  <summary>Harness Support Summary (Playbook Skills)</summary>
  <div class="harness-grid">
    {harnessSummary.map(h => (
      <article class="harness-card">
        <h3>{h.harness}</h3>
        <div class="status-counts">
          <span class="status-count pass"><Badge variant="pass">Full: {h.full}</Badge></span>
          <span class="status-count partial"><Badge variant="warn">Partial: {h.partial}</Badge></span>
          <span class="status-count planned"><Badge variant="info">Planned: {h.planned}</Badge></span>
          <span class="status-count none"><Badge variant="fail">None: {h.none}</Badge></span>
        </div>
      </article>
    ))}
  </div>
</details>