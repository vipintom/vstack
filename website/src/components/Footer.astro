---
import { withBase } from '../utils/urls';
---

<footer class="footer" role="contentinfo">
  <div class="footer-grid">
    <div>
      <p class="footer-wordmark">vstack</p>
      <hr class="footer-rule">
      <p style="font-size: var(--text-sm); color: var(--color-ink-muted); max-width: 20ch;">Engineering playbook + OpenCode runtime + OpenChamber visualization</p>
    </div>
    <nav class="footer-links" aria-label="Playbook">
      <a href={withBase('/playbook/')} style="font-weight: 600; color: var(--color-ink);">Playbook</a>
      <a href={withBase('/playbook/principles/')}>Principles</a>
      <a href={withBase('/playbook/roles/')}>Roles</a>
      <a href={withBase('/playbook/skills/')}>Skills</a>
      <a href={withBase('/playbook/workflows/')}>Workflows</a>
      <a href={withBase('/playbook/resources/')}>Resources</a>
      <a href={withBase('/playbook/capability-matrix')}>Capability Matrix</a>
      <a href={withBase('/playbook/install')}>Install</a>
    </nav>
    <nav class="footer-links" aria-label="OpenCode Plugin">
      <a href={withBase('/opencode-plugin/')} style="font-weight: 600; color: var(--color-ink);">OpenCode Plugin</a>
      <a href={withBase('/opencode-plugin/tools/')}>Tools</a>
      <a href={withBase('/opencode-plugin/stores/')}>Stores</a>
      <a href={withBase('/opencode-plugin/gates/')}>Gates</a>
      <a href={withBase('/opencode-plugin/agents/')}>Agents</a>
      <a href={withBase('/opencode-plugin/projections/')}>Projections</a>
      <a href={withBase('/opencode-plugin/install')}>Install</a>
    </nav>
    <nav class="footer-links" aria-label="OpenChamber">
      <a href={withBase('/openchamber/')} style="font-weight: 600; color: var(--color-ink);">OpenChamber</a>
      <a href={withBase('/openchamber/dashboard')}>Dashboard</a>
      <a href={withBase('/openchamber/delivery-detail')}>Delivery Detail</a>
      <a href={withBase('/openchamber/activity')}>Activity</a>
      <a href={withBase('/openchamber/memory')}>Memory</a>
      <a href={withBase('/openchamber/quality')}>Quality</a>
      <a href={withBase('/openchamber/api')}>API</a>
    </nav>
  </div>
  <div class="footer-bottom">
    <p class="footer-version">v0.1.0 · MIT · Built with Astro + Tailwind CSS v4</p>
    <nav class="footer-links" style="flex-direction: row; gap: var(--space-lg);" aria-label="External links">
      <a href="https://github.com/vipintom/vstack-workflow" target="_blank" rel="noopener">GitHub</a>
      <a href="https://www.npmjs.com/package/@vipintom/vstack" target="_blank" rel="noopener">npm</a>
      <a href="https://discord.gg/vstack" target="_blank" rel="noopener">Discord</a>
      <a href={withBase('/changelog')}>Changelog</a>
      <a href={withBase('/license')}>License</a>
    </nav>
  </div>
</footer>

<style>
  .footer { background: var(--color-paper-2); border-top: 1px solid var(--color-rule); padding: var(--space-3xl) var(--gutter) var(--space-xl); margin-top: var(--space-4xl); }
  .footer-grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: var(--gap-columns); max-width: var(--container); margin: 0 auto; }
  .footer-wordmark { font-family: var(--font-display); font-size: var(--text-title); font-weight: 700; letter-spacing: var(--tracking-display-s); color: var(--color-ink); margin-bottom: var(--space-lg); }
  .footer-rule { border: none; border-top: 1px solid var(--color-rule); margin: var(--space-lg) 0; }
  .footer-links { display: flex; flex-direction: column; gap: var(--space-xs); }
  .footer-links a { font-size: var(--text-sm); color: var(--color-ink-muted); text-decoration: none; transition: color var(--dur-micro); }
  .footer-links a:hover { color: var(--color-accent); }
  .footer-links a:focus-visible { outline-offset: 4px; }
  .footer-bottom { display: flex; justify-content: space-between; align-items: center; padding-top: var(--space-xl); border-top: 1px solid var(--color-rule); margin-top: var(--space-xl); max-width: var(--container); margin-left: auto; margin-right: auto; }
  .footer-version { font-size: var(--text-xs); color: var(--color-ink-faint); font-family: var(--font-mono); }
  @media (max-width: 768px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .footer-grid { grid-template-columns: 1fr; } }
</style>