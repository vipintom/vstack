<style>
  .footer { background: var(--color-paper-2); border-top: 1px solid var(--color-rule); padding: var(--space-3xl) var(--gutter) var(--space-xl); margin-top: var(--space-4xl); }
  .footer-grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: var(--gap-columns); max-width: var(--container); margin: 0 auto; }
  .footer-wordmark { font-family: var(--font-display); font-size: var(--text-title); font-weight: 700; letter-spacing: var(--tracking-display-s); color: var(--color-ink); margin-bottom: var(--space-lg); }
