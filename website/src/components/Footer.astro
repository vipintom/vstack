---
import { withBase } from '../utils/urls';
---

<footer class="footer" role="contentinfo">
  <div class="footer-grid">
    <div>
      <p class="footer-wordmark">vstack</p>
      <hr class="footer-rule">
      <p style="font-size: var(--text-sm); color: var(--color-ink-muted); max-width: 20ch;">Engineering playbook + OpenCode runtime + OpenChamber visualization</p>
    </div>
    <nav class="footer-links" aria-label="Playbook">
      <a href={withBase('/playbook/')} style="font-weight: 600; color: var(--color-ink);">Playbook</a>
      <a href={withBase('/playbook/principles/')}>Principles</a>
      <a href={withBase('/playbook/skills/')}>Skills</a>
      <a href={withBase('/playbook/workflows/')}>Workflows</a>
      <a href={withBase('/playbook/resources/')}>Resources</a>
      <a href={withBase('/compatibility/')}>Matrix</a>
      <a href={withBase('/install/')}>Install</a>
      <a href={withBase('/install/upgrade/')}>Upgrade</a>
      <a href={withBase('/install/removal/')}>Removal</a>
    </nav>
    <nav class="footer-links" aria-label="OpenCode Plugin">
      <a href={withBase('/opencode-plugin/')} style="font-weight: 600; color: var(--color-ink);">OpenCode Plugin</a>
      <a href={withBase('/opencode-plugin/tools/')}>Tools</a>
      <a href={withBase('/opencode-plugin/stores/')}>Stores</a>
      <a href={withBase('/opencode-plugin/gates/')}>Gates</a>
      <a href={withBase('/opencode-plugin/agents/')}>Agents</a>
      <a href={withBase('/opencode-plugin/projections/')}>Projections</a>
      <a href={withBase('/install/')}>Install</a>
      <a href={withBase('/install/upgrade/')}>Upgrade</a>
      <a href={withBase('/install/removal/')}>Removal</a>
    </nav>
    <nav class="footer-links" aria-label="OpenChamber">
      <a href={withBase('/openchamber/')} style="font-weight: 600; color: var(--color-ink);">OpenChamber</a>
      <a href={withBase('/openchamber/notes/')}>Notes</a>
      <a href={withBase('/openchamber/todos/')}>Todos</a>
      <a href={withBase('/openchamber/plans/')}>Plans</a>
      <a href={withBase('/openchamber/installation/')}>Installation</a>
    </nav>
  </div>
  <div class="footer-bottom">
    <p class="footer-version">v0.1.0<span class="footer-separator" aria-hidden="true"></span>MIT<span class="footer-separator" aria-hidden="true"></span>Built with Astro + Tailwind CSS v4</p>
    <nav class="footer-links" style="flex-direction: row; gap: var(--space-lg);" aria-label="External links">
      <a href="https://github.com/vipintom/vstack-playbook" target="_blank" rel="noopener">Playbook Repo</a>
      <a href="https://github.com/vipintom/vstack-opencode" target="_blank" rel="noopener">OpenCode Repo</a>
      <a href="https://github.com/vipintom/vstack-openchamber" target="_blank" rel="noopener">OpenChamber Repo</a>
      <a href="https://github.com/vipintom/vstack-workflow" target="_blank" rel="noopener">GitHub</a>
      <a href="https://www.npmjs.com/package/@vipintom/vstack" target="_blank" rel="noopener">npm</a>
    </nav>
  </div>
</footer>