  .footer-links a { font-size: var(--text-sm); color: var(--color-ink-muted); text-decoration: none; transition: color var(--dur-micro); }
  .footer-links a:hover { color: var(--color-accent); }
  .footer-links a:focus-visible { outline-offset: 4px; }
  .footer-bottom { display: flex; justify-content: space-between; align-items: center; padding-top: var(--space-xl); border-top: 1px solid var(--color-rule); margin-top: var(--space-xl); max-width: var(--container); margin-left: auto; margin-right: auto; }
  .footer-version { font-size: var(--text-xs); color: var(--color-ink-faint); font-family: var(--font-mono); }
  @media (max-width: 768px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .footer-grid { grid-template-columns: 1fr; } }
</style>