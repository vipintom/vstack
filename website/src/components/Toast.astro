<div class="toast" id="toast" aria-live="polite" aria-atomic="true"></div>

<style>
  .toast { position: fixed; bottom: var(--space-xl); right: var(--space-xl); background: var(--color-paper-3); border: 1px solid var(--color-rule); border-radius: var(--radius-sm); padding: var(--space-md) var(--space-lg); font-size: var(--text-sm); color: var(--color-ink); z-index: var(--z-toast); transform: translateY(100px); opacity: 0; transition: transform var(--dur-short) var(--ease-out), opacity var(--dur-short) var(--ease-out); pointer-events: none; }
  .toast.show { transform: translateY(0); opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .toast { transition: none; } }
</style>

<script set:html={`;(() => {
  if (typeof window === 'undefined') return;
  // Global toast function
  window.showToast = (message: string) => {
    const toast = document.getElementById('toast');
    if (toast) {
      toast.textContent = message;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2000);
    }
  };
})();`}>
</script>