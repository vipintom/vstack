---
interface Props {
  children: any;
  id?: string;
  class?: string;
  gap?: 's' | 'm' | 'l';
}
const { children, id, class: className = '', gap = 'm' } = Astro.props;
const gapPx = gap === 's' ? '96px' : gap === 'l' ? '184px' : '144px';
const gapClass = `gap-${gap}`;
---

<section id={id} class:list={['section', className, gapClass]} style={`padding-block: ${gapPx}; border-top: 1px solid var(--color-rule);`}>
  <slot />
</section>