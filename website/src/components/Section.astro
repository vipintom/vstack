---
interface Props {
  children: any;
  id?: string;
  class?: string;
  gap?: 's' | 'm' | 'l';
}
const { children, id, class: className = '', gap = 'm' } = Astro.props;
const gapVar = gap === 's' ? 'var(--section-gap-s)' : gap === 'l' ? 'var(--section-gap-l)' : 'var(--section-gap)';
---

<section id={id} class="section {className}" style="padding-block: {gapVar};">
  <slot />
</section>

<style>
  .section {
    border-top: 1px solid var(--color-rule);
  }
  .section:first-of-type { border-top: none; }
</style>