---
interface Props {
  placeholder?: string;
  value?: string;
  onInput?: (value: string) => void;
  class?: string;
  'aria-label'?: string;
}
const { placeholder = 'Search…', value = '', onInput, class: className = '', 'aria-label': ariaLabel = 'Search' } = Astro.props;
---

<label class="search-label">
  <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
  <input
    type="search"
    class="search-input {className}"
    placeholder={placeholder}
    value={value}
    aria-label={ariaLabel}
  />
  {value && <button type="button" class="search-clear" aria-label="Clear search"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>}
</label>

<style>
  .search-label { position: relative; display: flex; align-items: center; width: 100%; max-width: 320px; }
  .search-icon { position: absolute; left: var(--space-sm); color: var(--color-ink-faint); pointer-events: none; flex-shrink: 0; }
  .search-input { width: 100%; height: 40px; padding: 0 var(--space-md) 0 calc(var(--space-md) + 20px); font-family: var(--font-body); font-size: var(--text-sm); line-height: 1; color: var(--color-ink); background: var(--color-paper-2); border: 2px solid var(--color-rule); border-radius: var(--radius-sm); transition: border-color var(--dur-micro) var(--ease-out), box-shadow var(--dur-micro) var(--ease-out); }
  .search-input:focus { outline: none; border-color: var(--color-focus); box-shadow: 0 0 0 3px oklch(55% 0.22 35 / 0.2); }
  .search-input::placeholder { color: var(--color-ink-faint); }
  .search-clear { position: absolute; right: var(--space-sm); display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; background: none; border: none; color: var(--color-ink-faint); cursor: pointer; border-radius: var(--radius-xs); transition: color var(--dur-micro); }
  .search-clear:hover { color: var(--color-accent); }
</style>