---
import { withBase } from '../utils/urls';
import SearchPagefind from './SearchPagefind.astro';

// Primary navigation items per PRD Section 12.1
const navItems = [
  { label: 'Products', href: withBase('/products/'), children: [
    { label: 'Playbook', href: withBase('/playbook/') },
    { label: 'OpenCode Plugin', href: withBase('/opencode-plugin/') },
    { label: 'OpenChamber', href: withBase('/openchamber/') },
    { label: 'Compare', href: withBase('/products/compare/') },
  ]},
  { label: 'Architecture', href: withBase('/architecture/') },
  { label: 'Capabilities', href: withBase('/capabilities/') },
  { label: 'Documentation', href: withBase('/docs/') },
  { label: 'Releases', href: withBase('/releases/') },
];

// Edge-aligned nav: wordmark left, nav links center, search, Install button right, theme toggle
---

<nav class="nav" role="navigation" aria-label="Main navigation">
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <a href={withBase('/')} class="nav-wordmark" aria-label="vstack home">vstack</a>
  
  <div class="nav-links" role="menubar">
    {navItems.map(item => item.children ? (
      <div class="nav-dropdown" role="menuitem">
        <button class="nav-link nav-dropdown-toggle" aria-haspopup="true" aria-expanded="false">
          {item.label}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          {item.children.map(child => (
            <a href={child.href} class="nav-dropdown-item" role="menuitem">{child.label}</a>
          ))}
        </div>
      </div>
    ) : (
      <a href={item.href} class="nav-link" role="menuitem">{item.label}</a>
    ))}
  </div>

  <div class="nav-search">
    <SearchPagefind />
  </div>

  <div class="nav-actions">
    <a href={withBase('/install/')} class="btn btn-primary">Install</a>
    <button class="btn btn-ghost nav-toggle" aria-label="Toggle theme" aria-pressed="true" id="themeToggle">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="5"/>
        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
      </svg>
    </button>
  </div>
</nav>

<script set:html={`;(() => {
  if (typeof document === 'undefined') return;
  // Theme toggle
  const toggle = document.getElementById('themeToggle');
  if (!toggle) return;
  toggle.addEventListener('click', () => {
    const html = document.documentElement;
    const isLight = html.getAttribute('data-theme') === 'light';
    html.setAttribute('data-theme', isLight ? 'dark' : 'light');
    toggle.setAttribute('aria-pressed', !isLight);
    localStorage.setItem('theme', isLight ? 'dark' : 'light');
  });
})();`}>
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky-nav);
    height: var(--banner-height);
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-rule);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--gutter);
    gap: var(--space-xl);
  }

  .nav-wordmark {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 700;
    letter-spacing: var(--tracking-display-s);
    color: var(--color-ink);
    text-decoration: none;
    flex-shrink: 0;
    min-height: 48px;
    min-width: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xs) var(--space-sm);
  }
  .nav-wordmark:hover { color: var(--color-accent); }
  .nav-wordmark:focus-visible { outline-offset: 4px; }

  .skip-link {
    position: absolute;
    top: -100%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    z-index: var(--z-tooltip);
    font-weight: 600;
    text-decoration: none;
    transition: top var(--dur-short) var(--ease-out);
    min-height: 48px;
    min-width: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .skip-link:focus {
    top: var(--space-md);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex: 1;
    justify-content: center;
    position: relative;
  }

  .nav-link {
    color: var(--color-ink-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    transition: color var(--dur-micro), background-color var(--dur-micro);
    white-space: nowrap;
    min-height: 48px;
    min-width: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .nav-link:hover { color: var(--color-ink); background: var(--color-paper-2); }
  .nav-link:focus-visible { outline-offset: 2px; }
  .nav-link[aria-current="page"] { color: var(--color-accent); }

  .nav-dropdown { position: relative; }
  .nav-dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    background: none;
    border: none;
    color: var(--color-ink-muted);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    transition: color var(--dur-micro), background-color var(--dur-micro);
    min-height: 48px;
    min-width: 48px;
  }
  .nav-dropdown-toggle:hover { color: var(--color-ink); background: var(--color-paper-2); }
  .nav-dropdown-toggle:focus-visible { outline-offset: 2px; }

  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: var(--space-xs);
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    padding: var(--space-sm);
    min-width: 180px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity var(--dur-short), visibility var(--dur-short), transform var(--dur-short);
    z-index: var(--z-dropdown);
  }
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-dropdown-item {
    display: inline-flex;
    align-items: center;
    color: var(--color-ink-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    transition: color var(--dur-micro), background-color var(--dur-micro);
    min-height: 48px;
    min-width: 48px;
    justify-content: center;
  }
  .nav-dropdown-item:hover { color: var(--color-ink); background: var(--color-paper-3); }
  .nav-dropdown-item:focus-visible { outline-offset: -2px; }

  .nav-actions { display: flex; align-items: center; gap: var(--space-md); flex-shrink: 0; }

  .nav-actions .btn {
    min-height: 48px;
    min-width: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .nav-toggle { display: flex; align-items: center; justify-content: center; background: none; border: none; color: var(--color-ink); cursor: pointer; padding: var(--space-md); border-radius: var(--radius-sm); min-width: 48px; min-height: 48px; }
  .nav-toggle:hover { background: var(--color-paper-2); }
  .nav-toggle:focus-visible { outline-offset: 2px; }

  .nav-search {
    display: flex;
    align-items: center;
    flex-shrink: 1;
    max-width: 320px;
  }
  .nav-search :global(.search-ui-container) {
    width: 100%;
    max-width: 100%;
  }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    .nav-toggle { display: flex; }
  }
</style>

<script set:html={`;(() => {
  if (typeof document === 'undefined') return;
  // Theme toggle
  const toggle = document.getElementById('themeToggle');
  if (!toggle) return;
  toggle.addEventListener('click', () => {
    const html = document.documentElement;
    const isLight = html.getAttribute('data-theme') === 'light';
    html.setAttribute('data-theme', isLight ? 'dark' : 'light');
    toggle.setAttribute('aria-pressed', !isLight);
    localStorage.setItem('theme', isLight ? 'dark' : 'light');
  });
})();`}>
</script>