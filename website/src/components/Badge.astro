---
interface Props {
  children: any;
  variant?: 'pass' | 'warn' | 'error' | 'info' | 'plan' | 'fail';
  class?: string;
}
const { children, variant = 'pass', class: className = '' } = Astro.props;
const variantClass = `badge-{variant}`;
---

<span class="badge {variantClass} {className}"><slot /></span>

<style>
  .badge { display: inline-flex; align-items: center; gap: var(--space-2xs); padding: var(--space-2xs) var(--space-xs); font-family: var(--font-mono); font-size: var(--text-xs); line-height: 1; border-radius: var(--radius-xs); white-space: nowrap; }
  .badge-pass { background: var(--color-badge-pass-bg); color: var(--color-badge-pass-text); border: 1px solid var(--color-badge-pass-border); }
  .badge-warn { background: var(--color-badge-warn-bg); color: var(--color-badge-warn-text); border: 1px solid var(--color-badge-warn-border); }
  .badge-error { background: var(--color-badge-error-bg); color: var(--color-badge-error-text); border: 1px solid var(--color-badge-error-border); }
  .badge-info { background: var(--color-badge-info-bg); color: var(--color-badge-info-text); border: 1px solid var(--color-badge-info-border); }
  .badge-plan { background: var(--color-badge-plan-bg); color: var(--color-badge-plan-text); border: 1px solid var(--color-badge-plan-border); }
  .badge-fail { background: var(--color-badge-fail-bg); color: var(--color-badge-fail-text); border: 1px solid var(--color-badge-fail-border); }
</style>