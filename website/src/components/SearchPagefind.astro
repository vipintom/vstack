---
import { withBase } from '../utils/urls';
---

<!-- Pagefind Search UI -->
<div id="search-ui" class="search-ui-container"></div>

<style>
  .search-ui-container {
    position: relative;
    width: 100%;
    max-width: 400px;
  }
  
  /* Pagefind UI customizations */
  .pagefind-ui {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--color-primary);
    --pagefind-ui-text: var(--color-ink);
    --pagefind-ui-background: var(--color-surface);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-tag: var(--color-primary);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius-md);
    --pagefind-ui-image-border-radius: var(--radius-sm);
    font-family: var(--font-body);
  }
  
  .pagefind-ui__search-input {
    background: var(--color-paper-2) !important;
    border: 2px solid var(--color-rule) !important;
    color: var(--color-ink) !important;
    font-family: var(--font-body) !important;
    font-size: var(--text-sm) !important;
    padding: var(--space-sm) var(--space-md) !important;
  }
  
  .pagefind-ui__search-input:focus {
    border-color: var(--color-primary) !important;
    box-shadow: 0 0 0 3px oklch(55% 0.22 35 / 0.2) !important;
  }
  
  .pagefind-ui__search-input::placeholder {
    color: var(--color-ink-muted) !important;
  }
  
  .pagefind-ui__result {
    background: var(--color-paper-2) !important;
    border: 1px solid var(--color-rule) !important;
    border-radius: var(--radius-md) !important;
  }
  
  .pagefind-ui__result:hover {
    background: var(--color-paper-3) !important;
  }
  
  .pagefind-ui__result-title {
    color: var(--color-ink) !important;
    font-family: var(--font-display) !important;
    font-weight: 600 !important;
  }
  
  .pagefind-ui__result-excerpt {
    color: var(--color-ink-muted) !important;
  }
  
  .pagefind-ui__result-meta {
    color: var(--color-ink-faint) !important;
    font-family: var(--font-mono) !important;
    font-size: var(--text-xs) !important;
  }
  
  .pagefind-ui__message {
    color: var(--color-ink-muted) !important;
  }
  
  .pagefind-ui__counter {
    color: var(--color-ink-faint) !important;
  }
  
  .pagefind-ui__filter-group {
    border-color: var(--color-rule) !important;
  }
  
  .pagefind-ui__filter-option {
    color: var(--color-ink) !important;
  }
  
  .pagefind-ui__filter-option[aria-selected="true"] {
    background: var(--color-primary) !important;
    color: var(--color-primary-foreground) !important;
  }
  
  /* Dark mode adjustments */
  [data-theme="dark"] .pagefind-ui {
    --pagefind-ui-background: var(--color-surface);
    --pagefind-ui-text: var(--color-ink);
    --pagefind-ui-border: var(--color-border);
  }
  
  /* Mobile */
  @media (max-width: 768px) {
    .search-ui-container {
      max-width: 100%;
    }
  }
</style>

<script>
  // Initialize Pagefind search
  if (typeof window !== 'undefined') {
    window.addEventListener('DOMContentLoaded', () => {
      // Load Pagefind JS
      const script = document.createElement('script');
      script.src = '/_pagefind/pagefind.js';
      script.async = true;
      script.onload = () => {
        if (window.pagefind) {
          const searchContainer = document.getElementById('search-ui');
          if (searchContainer) {
            new window.pagefind.Search({
              element: searchContainer,
              showImages: false,
              showSubResults: true,
              resetStyles: true,
              translations: {
                placeholder: 'Search vstack docs…',
                zeroResults: 'No results for "[SEARCH_TERM]"',
                manyResults: '[COUNT] results for "[SEARCH_TERM]"',
                searchLabel: 'Search documentation',
              }
            });
          }
        }
      };
      document.head.appendChild(script);
    });
  }
</script>