---
interface Props {
  children: any;
  class?: string;
  narrow?: boolean;
}
const { children, class: className = '', narrow = false } = Astro.props;
const narrowClass = narrow ? 'content-wide' : '';
---

<div class:list={['container', narrowClass, className]}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .container.content-wide {
    max-width: 1080px;
  }
</style>