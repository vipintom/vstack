---
import Layout from '@layouts/Layout.astro';
import Nav from '@components/Nav.astro';
import Container from '@components/Container.astro';
import Footer from '@components/Footer.astro';
import Toast from '@components/Toast.astro';
import DocSidebar from '@components/DocSidebar.astro';

interface Props {
  title: string;
  description?: string;
  sidebarTitle?: string;
  sidebarItems?: Array<{ label: string; href: string; active?: boolean; children?: Array<{ label: string; href: string; active?: boolean }> }>;
}

const { title, description, sidebarTitle, sidebarItems } = Astro.props;
---

<Layout title={title} description={description}>
  <Nav />
  <Toast />
  <div class="doc-layout">
    {sidebarItems && <DocSidebar title={sidebarTitle || 'Documentation'} items={sidebarItems} />}
    <div class="doc-content">
      <main id="main-content">
        <slot />
      </main>
    </div>
  </div>
  <Footer />
</Layout>

<style>
  .doc-layout { display: flex; gap: var(--gap-columns); max-width: var(--container); margin: 0 auto; padding: var(--space-xl) var(--gutter); }
  .doc-content { flex: 1; min-width: 0; max-width: 65ch; }
  main { width: 100%; }

  @media (max-width: 1024px) {
    .doc-layout { flex-direction: column; padding: var(--space-lg) var(--gutter); }
    .doc-content { max-width: none; }
  }
</style>