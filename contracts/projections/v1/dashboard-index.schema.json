{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vstack.dev/schemas/projections/v1/dashboard-index.json",
  "title": "vstack Dashboard Index",
  "description": "Small, frequently-polled index of active deliveries for OpenChamber dashboard. Located at .vstack/state/index.json",
  "allOf": [
    { "$ref": "projection-envelope.schema.json" },
    {
      "type": "object",
      "required": ["activeDeliveries"],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonically increasing revision. Only advances when activeDeliveries content changes."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last index change"
        },
        "activeDeliveries": {
          "type": "array",
          "description": "Summary of active deliveries (status: proposed, active, or blocked)",
          "items": {
            "type": "object",
            "required": ["id", "title", "type", "profile", "status", "currentPhase", "updatedAt", "revision"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^dlv_[a-zA-Z0-9_-]+$",
                "description": "Delivery ID with dlv_ prefix"
              },
              "title": {
                "type": "string",
                "description": "Human-readable delivery title"
              },
              "type": {
                "type": "string",
                "enum": ["feature", "bugfix", "refactor", "migration", "infrastructure", "documentation", "operations", "release", "other"],
                "description": "Delivery type classification"
              },
              "profile": {
                "type": "string",
                "enum": ["bug-fix", "feature", "refactor", "architecture-change", "infrastructure-change", "documentation", "release-only"],
                "description": "Delivery profile determining phase sequence"
              },
              "status": {
                "type": "string",
                "enum": ["proposed", "active", "blocked", "completed", "cancelled", "failed"],
                "description": "Current delivery status"
              },
              "currentPhase": {
                "type": "string",
                "enum": ["intake", "discovery", "design", "planning", "implementation", "validation", "review", "release_preparation", "deployment", "post_release", "completed"],
                "description": "Current phase in the delivery lifecycle"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 timestamp of last delivery update"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "description": "Delivery revision number"
              }
            }
          }
        }
      }
    }
  ]
}