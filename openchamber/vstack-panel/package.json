{
  "name": "@vstack/openchamber",
  "version": "0.1.0",
  "type": "module",
  "openchamber": {
    "apiVersion": 1,
    "engines": { "openchamber": ">=1.24.0" },
    "contributes": {
      "panel": {
        "id": "vstack-workflow",
        "name": "vstack Workflow",
        "icon": "git-branch",
        "entry": "panel/index.html"
      },
      "page": {
        "id": "vstack-workflow-dashboard",
        "name": "vstack Dashboard",
        "icon": "dashboard",
        "entry": "panel/dashboard.html"
      },
      "capabilities": ["files"]
    }
  },
  "scripts": {
    "build": "bunx @openchamber/sdk/scripts/bundle-guest.ts panel/main.ts panel/main.js && bunx @openchamber/sdk/scripts/bundle-guest.ts panel/dashboard.ts panel/dashboard.js",
    "dev": "bunx @openchamber/sdk/scripts/bundle-guest.ts panel/main.ts panel/main.js --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@openchamber/sdk": "latest",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}