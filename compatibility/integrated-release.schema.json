{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vstack.dev/schemas/compatibility/integrated-release-v1.json",
  "title": "vstack Integrated Release Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "release",
    "releasedAt",
    "components",
    "protocol",
    "compatibility"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Schema version of this manifest format"
    },
    "release": {
      "type": "string",
      "pattern": "^vstack-\\d{4}\\.\\d{2}\\.\\d{2}(?:-\\w+)?$",
      "description": "Integrated release identifier (e.g., vstack-2026.11.02 or vstack-2026.11.02-hotfix)"
    },
    "releasedAt": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp of the integrated release"
    },
    "components": {
      "type": "object",
      "required": ["playbook", "opencode", "openchamber"],
      "additionalProperties": false,
      "properties": {
        "playbook": { "$ref": "#/$defs/componentRef" },
        "opencode": { "$ref": "#/$defs/componentRef" },
        "openchamber": { "$ref": "#/$defs/componentRef" }
      }
    },
    "protocol": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+$",
          "description": "Projection protocol version (integer as string)"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["status", "notes"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["tested", "untested", "partial", "failed"],
          "description": "Overall compatibility test status"
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "description": "Summary of testing evidence or limitations"
        },
        "evidenceSummary": {
          "type": "string",
          "description": "Optional detailed evidence summary"
        }
      }
    }
  },
  "$defs": {
    "componentRef": {
      "type": "object",
      "required": ["repository", "version", "tag", "commit"],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]+/[a-zA-Z0-9-]+$",
          "description": "GitHub repository in format 'owner/repo'"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+)?$",
          "description": "Semantic version of the component"
        },
        "tag": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "description": "Git tag for this version (v-prefixed semver)"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full 40-character Git commit SHA"
        }
      }
    }
  }
}